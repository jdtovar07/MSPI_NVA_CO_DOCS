  "document_item_catalog_id" uuid [not null]
  "delivery_status" "character varying(20)" [not null, default: `'NOT_DELIVERED'::charactervarying`, note: '''HU-CFG-05 (entregado / no entregado / parcial):
- DELIVERED
- NOT_DELIVERED
- PARTIAL
Regla sugerida: PARTIAL si hay delivered_name o adjuntos pero incompleto; manual permitido.
''']
  "delivered_name" "character varying(260)" [note: 'Nombre del documento entregado (HU-CFG-05).']
