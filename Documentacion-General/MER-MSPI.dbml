  }
  Note: '''FK compuesta lógica: (assessment_id, document_item_catalog_id) única.
Archivos: evidence_file.relation_type=LIFTING_DOC, relation_id=id (esta tabla).
'''
}

Table "evidence"."process_scope_metric" {
  "assessment_id" uuid [pk, not null]
  "total_processes" integer [not null, default: 0, note: 'Total procesos de la entidad. 0 → coverage NULL (no aplica).']
  "in_scope_processes" integer [not null, default: 0, note: 'Procesos en alcance del MSPI.']
  "coverage" numeric(6,4) [note: '''HU-CFG-05 ítem 43: %MSPI = in_scope_processes / total_processes.
Calculado en app/trigger: NULL si total_processes=0 (UI muestra "no aplica").
Si total_processes>0: round(4 decimales). Ej. 5/20 = 0.25 (25%).
''']
  "in_scope_exceeds_total" boolean [not null, default: false, note: 'HU-CFG-05: true si in_scope_processes > total_processes → advertencia en UI.']
  "updated_by" uuid
  "updated_at" timestamp [not null, default: `now()`]
  Note: '''Relación 1:1 con assessment. Crear al crear evaluación con ceros.
'''
}

