  "scheduled_deletion_at" timestamp [note: 'Fecha programada del borrado lógico (aprobación + catalogDeletionGraceDays).']
  "decision_by" uuid
  "decision_by_name" "character varying(200)"
  "decision_at" timestamp
  "decision_comment" text
