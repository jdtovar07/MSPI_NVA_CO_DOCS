Table "assessment"."gap_register" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "control_response_id" uuid
  "title" "character varying(220)"
  "gap_text" text [not null]
  "priority" "character varying(10)" [not null, default: `'MEDIA'::charactervarying`]
  "owner" "character varying(200)"
  "due_date" date
  "status" "character varying(20)" [not null, default: `'PENDIENTE'::charactervarying`]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Indexes {
    assessment_id [type: btree, name: "gap_register_assessment_id_idx"]
    (assessment_id, priority) [type: btree, name: "gap_register_assessment_id_priority_idx"]
    (assessment_id, status) [type: btree, name: "gap_register_assessment_id_status_idx"]
  }
  Note: '''HU-REP-03 (Módulo 9): listado priorizado de brechas (score < 60) se obtiene on-read desde
assessment_control_node (hoja) + control_response + steward efectivo (HU-AR-01);
brecha(c) = 100 - score_value. gap_register es extensión opcional para recomendaciones/plan de acción
persistidas por el evaluador (no sustituye el listado calculado de REP-03).
Módulo 8 (HU-DIAG): el tablero Portada NO usa esta tabla; usa rollup por dominio y resúmenes PHVA/Madurez/NIST.
'''
}

Table "assessment"."nist_ciber_item_response" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "nist_ciber_item_id" uuid [not null]
  "score_status" "character varying(10)" [not null, default: `'SCORED'::charactervarying`, note: '''HU-CIB-01 — SCORED | NA (misma escala 0–100 que controles).
Al crear evaluación: solo filas MANUAL con SCORED y score_value=0.
''']
  "score_value" integer [note: '''0 | 20 | 40 | 60 | 80 | 100 cuando score_status=SCORED; NULL si NA.
effective_score para MANUAL = score_value (o excluido si NA).
Validación contra catalog.scale_level al PATCH.
''']
  "evidence_text" text
  "gap_text" text
  "updated_by" uuid
  "updated_at" timestamp [not null, default: `now()`]
  "version" integer [not null, default: 0]

  Indexes {
    assessment_id [type: btree, name: "nist_ciber_item_response_assessment_id_idx"]
    (assessment_id, nist_ciber_item_id) [type: btree, unique, name: "nist_ciber_item_response_assessment_id_nist_ciber_item_id_idx"]
    (assessment_id, score_status) [type: btree, name: "nist_ciber_item_response_assessment_id_score_status_idx"]
  }
  Note: '''1:1 con assessment_nist_ciber_item donde scoring_mode=MANUAL (~13 filas típicas MSPI v1).
NO crear fila para INHERITED (c_i = control_response on-read).
PATCH permitido solo en ítems MANUAL; invalidar cache NIST si existe.
'''
}

Table "assessment"."phva_item_response" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "phva_item_id" uuid [not null]
  "score_status" "character varying(10)" [not null, default: `'SCORED'::charactervarying`, note: '''HU-PHVA-01..04 — SCORED | NA (misma escala que controles).
CHECK: score_status IN (\'SCORED\',\'NA\').
Al crear evaluación: solo filas MANUAL con SCORED y score_value=0.
''']
  "score_value" integer [note: '''0 | 20 | 40 | 60 | 80 | 100 cuando score_status=SCORED; NULL si NA o sin calificar.
Validación contra catalog.scale_level al PATCH.
''']
  "evidence_text" text
  "gap_text" text
  "updated_by" uuid
  "updated_at" timestamp [not null, default: `now()`]
  "version" integer [not null, default: 0]

  Indexes {
    assessment_id [type: btree, name: "phva_item_response_assessment_id_idx"]
    (assessment_id, phva_item_id) [type: btree, unique, name: "phva_item_response_assessment_id_phva_item_id_idx"]
    (assessment_id, score_status) [type: btree, name: "phva_item_response_assessment_id_score_status_idx"]
  }
  Note: '''1:1 con assessment_phva_item donde scoring_mode=MANUAL.
NO crear fila para INHERITED (valor efectivo = función de control_response / rollup / Anexo A).
Promedio componente C: avg(effective_score de ítems del componente), excluyendo NA.
Si todos NA en un componente → avance componente = 0 (HU-PHVA-01 caso borde).
'''
}

Table "audit"."audit_log" {
  "id" bigint [pk, not null]
  "event_type" "character varying(80)" [not null, note: '''Autenticación (ms_iam, entity_type=AUTH; entity_id=usernameOrEmail):
- AUTH_LOGIN_SUCCESS
- AUTH_LOGIN_FAILED
- AUTH_LOGIN_INACTIVE
Eventos Módulo 1 / negocio:
- ASSESSMENT_CREATED
- ASSESSMENT_PUBLISHED (status → CERRADA)
- ASSESSMENT_CLONED
- ENTITY_ORDER_TYPE_CHANGED (HU-CFG-02; before_json/after_json)
- STEWARD_PROPAGATED (opcional HU-AR-01; tras guardar assignments de áreas)
- INVENTORY_DELIVERY_UPDATED
''']
  "entity_type" "character varying(80)" [not null, note: 'AUTH|ASSESSMENT|ORGANIZATION|USER|...']
  "entity_id" "character varying(120)" [not null]
  "assessment_id" uuid [note: 'UUID de evaluación opcional; sin FK a assessment (desacople).']
  "actor_user_id" uuid [note: 'UUID de usuario opcional; sin FK a iam.user (desacople).']
  "occurred_at" timestamp [not null, default: `now()`]
  "ip" "character varying(64)"
  "user_agent" "character varying(400)"
  "before_json" jsonb
  "after_json" jsonb
  "metadata_json" jsonb

  Indexes {
    (actor_user_id, occurred_at) [type: btree, name: "audit_log_actor_user_id_occurred_at_idx"]
    (assessment_id, occurred_at) [type: btree, name: "audit_log_assessment_id_occurred_at_idx"]
    (entity_type, entity_id) [type: btree, name: "audit_log_entity_type_entity_id_idx"]
    (event_type, occurred_at) [type: btree, name: "audit_log_event_type_occurred_at_idx"]
    (actor_user_id, occurred_at) [type: btree, name: "idx_audit_audit_log_actor_occurred"]
    (assessment_id, occurred_at) [type: btree, name: "idx_audit_audit_log_assessment_occurred"]
    (entity_type, entity_id) [type: btree, name: "idx_audit_audit_log_entity"]
    (event_type, occurred_at) [type: btree, name: "idx_audit_audit_log_event_occurred"]
  }
  Note: 'Auditoría central (ms_audit :8088). assessment_id/actor_user_id sin FK.'
}

