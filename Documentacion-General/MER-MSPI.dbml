Table "assessment"."control_response" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "control_node_id" uuid [not null]
  "score_status" "character varying(10)" [not null, default: `'PENDING'::charactervarying`, note: '''HU-ADM-01 #23 / HU-TEC-01 #40 — dominio: PENDING | SCORED | NA.
Al crear evaluación (HU-CFG-01): score_status=PENDING y score_value=NULL (sin calificar).
El rollup / progress solo cuenta hojas SCORED con score_value no nulo.
''']
  "score_value" integer [note: '''Escala MSPI discreta (HU-ADM-01 #23 / HU-TEC-01 #40): 0 | 20 | 40 | 60 | 80 | 100.
Reglas:
  * score_status=\'PENDING\' ⇒ score_value IS NULL
  * score_status=\'NA\'      ⇒ score_value IS NULL
  * score_status=\'SCORED\'  ⇒ score_value IN (0,20,40,60,80,100)
Validación contra catalog.scale_level publicada al PATCH (ms_catalog).
''']
  "evidence_text" text [note: 'HU-ADM-01 #25 / HU-TEC-01 #40: evidencia textual. Adjuntos: evidence.evidence_file relation_type=CONTROL_RESPONSE.']
  "gap_text" text [note: 'HU-ADM-01 #25 / HU-TEC-01 #40: brecha identificada (texto).']
  "recommendation_text" text [note: 'HU-ADM-01 #25 / HU-TEC-01 #40: recomendación; obligatoriedad vía catalog.control_rule.']
  "control_status" "character varying(30)" [not null, default: `'PENDIENTE'::charactervarying`]
  "steward_source" "character varying(14)" [not null, default: `'FROM_AREA'::charactervarying`, note: '''HU-AR-01 criterios 21-22:
FROM_AREA → persona mostrada/notificada viene de assessment_area_topic.default_steward_role_code = node\'s default_steward_role_code (propagación).
CUSTOM → se usan steward_custom_*; no se sobrescribe al actualizar assignments por área.
''']
  "steward_custom_name" "character varying(200)"
  "steward_custom_staff_role" "character varying(160)" [note: 'Cargo texto capturado en override (opcional UI).']
  "steward_custom_contact" "character varying(200)"
  "updated_by" uuid
  "updated_at" timestamp [not null, default: `now()`]
  "version" integer [not null, default: 0]

  Indexes {
    (assessment_id, control_node_id) [type: btree, unique, name: "control_response_assessment_id_control_node_id_idx"]
    (assessment_id, control_status) [type: btree, name: "control_response_assessment_id_control_status_idx"]
    assessment_id [type: btree, name: "control_response_assessment_id_idx"]
    (assessment_id, score_status) [type: btree, name: "control_response_assessment_id_score_status_idx"]
    (assessment_id, steward_source) [type: btree, name: "control_response_assessment_id_steward_source_idx"]
  }
}

