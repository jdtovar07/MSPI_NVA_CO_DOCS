Table "catalog"."scale" {
  "id" uuid [pk, not null]
  "name" "character varying(140)" [unique, not null]
  "description" "character varying(400)"
  "is_base" boolean [not null, default: false, note: 'true = elemento base del instrumento MSPI (no eliminable).']
  "deleted_at" timestamp [note: 'Borrado lógico tras aprobación y gracia. NULL = activa.']
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    deleted_at [type: btree, name: "catalog_scale_deleted_at_idx"]
    deleted_at [type: btree, name: "scale_deleted_at_idx"]
  }
}

Table "catalog"."scale_band" {
  "id" uuid [pk, not null]
  "scale_version_id" uuid [not null]
  "min_value" integer [not null]
  "max_value" integer [not null]
  "label" "character varying(60)" [not null, note: 'INEXISTENTE|INICIAL|REPETIBLE|EFECTIVO|GESTIONADO|OPTIMIZADO']
  "position" integer [not null]

  Indexes {
    scale_version_id [type: btree, name: "scale_band_scale_version_id_idx"]
    (scale_version_id, position) [type: btree, name: "scale_band_scale_version_id_position_idx"]
  }
}

Table "catalog"."scale_level" {
  "id" uuid [pk, not null]
  "scale_version_id" uuid [not null]
  "label" "character varying(80)" [not null]
  "value" integer [note: '0|20|40|60|80|100; null si is_na=true']
  "is_na" boolean [not null, default: false]
  "criteria_text" "character varying(1200)"
  "position" integer [not null]

  Indexes {
    scale_version_id [type: btree, name: "scale_level_scale_version_id_idx"]
    (scale_version_id, position) [type: btree, name: "scale_level_scale_version_id_position_idx"]
    (scale_version_id, value) [type: btree, unique, name: "scale_level_scale_version_id_value_idx"]
  }
}

Table "catalog"."scale_version" {
  "id" uuid [pk, not null]
  "scale_id" uuid [not null]
  "version" integer [not null]
  "status" "character varying(20)" [not null, default: `'DRAFT'::charactervarying`, note: 'DRAFT|PUBLISHED']
  "published_at" timestamp
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    (scale_id, version) [type: btree, unique, name: "scale_version_scale_id_version_idx"]
    status [type: btree, name: "scale_version_status_idx"]
  }
}

Table "catalog"."steward_role" {
  "code" "character varying(60)" [pk, not null, note: '''Código estable ej. RESP_CONTROL_INTERNO | RESP_GESTION_HUMANA | LIDER_PROCESO_COMPRAS |
RESP_COMPRAS | RESP_CONTINUIDAD | RESP_SEG_FISICA | RESP_TICS | RESP_SI
(ajustar nomenclatura exacta al seed oficial / Excel).
''']
  "label" "character varying(160)" [not null, note: 'Etiqueta UI y reporte, ej. Responsable de SI']
  "sort_order" integer [not null, default: 0]
  "active" boolean [not null, default: true]

  Indexes {
    sort_order [type: btree, name: "steward_role_sort_order_idx"]
  }
  Note: '''HU-AR-01 regla: el cargo es metadata del instrumento; seed en ms_catalog.
Cada control hoja (ADM/TEC) referencia un default_steward_role_code; cada fila assessment_area_topic puede
cubrir el mismo código para asignar funcionario que luego se propaga a todos los control_response con FROM_AREA.
'''
}

Table "catalog"."template" {
  "id" uuid [pk, not null]
  "name" "character varying(180)" [unique, not null]
  "description" "character varying(500)"
  "created_at" timestamp [not null, default: `now()`]
}

Table "catalog"."template_version" {
  "id" uuid [pk, not null]
  "template_id" uuid [not null]
  "scale_version_id" uuid [not null]
  "version" integer [not null]
  "status" "character varying(20)" [not null, default: `'DRAFT'::charactervarying`, note: 'DRAFT|PUBLISHED']
  "published_at" timestamp
  "created_at" timestamp [not null, default: `now()`]
  "maturity_global_rule" "character varying(40)" [note: 'MIN|AVG|MAJORITY — legacy Excel; HU-MAD no lo usa en v1.']
  "maturity_crit_thresholds" jsonb [note: '''HU-MAD-05 — umbrales de conteo de MENOR por nivel → SUFICIENTE | INTERMEDIO | CRÍTICO.
Seed MSPI v1 (límites exclusivos superiores, igual pseudocódigo Historias v2):
{
  "1": {"sufficientMax": 3, "intermediateMax": 7},
  "2": {"sufficientMax": 7, "intermediateMax": 15},
  "3": {"sufficientMax": 14, "intermediateMax": 30},
  "4": {"sufficientMax": 20, "intermediateMax": 40},
  "5": {"sufficientMax": 20}
}
Interpretación: menores(L) < sufficientMax → SUFICIENTE;
  menores(L) < intermediateMax → INTERMEDIO; si no → CRÍTICO.
Nivel 5: sin rango INTERMEDIO explícito (≥ intermediateMax ⇒ CRÍTICO).
requisitos(L) = { n : maturity_threshold(n,L).is_na = false }.
''']
  "phva_weights" jsonb [note: '''HU-PHVA-01..05 — pesos por componente (enteros, suma = 100). Seed MSPI v1:
{"PLAN": 40, "DO": 20, "CHECK": 20, "ACT": 20}
PLAN=Planificación | DO=Implementación | CHECK=Evaluación desempeño | ACT=Mejora continua
''']
  "phva_caps" jsonb [note: '''HU-PHVA-01..05 — topes de avance ponderado por componente (mismo esquema de claves que phva_weights).
Seed MSPI v1: {"PLAN": 40, "DO": 20, "CHECK": 20, "ACT": 20}
L_C_capado = min(cap[C], (avg(requisitos C) × peso[C]) / 100)
''']
  "nist_function_targets" jsonb [note: '''HU-CIB-02 #86 — meta de cumplimiento por función NIST (configurable por template publicada).
Seed MSPI v1 (por defecto 60 en las cinco funciones; ideal para radar HU-CIB-03):
{
  "ID": 60, "PR": 60, "DE": 60, "RS": 60, "RC": 60,
  "ideal": 100
}
Claves ID|PR|DE|RS|RC = catalog.nist_function.code.
estado(f) = ALCANZA si promedio(f) ≥ meta(f); NO ALCANZA si promedio(f) < meta(f).
brecha(f) = meta(f) - promedio(f) cuando NO ALCANZA (≥ 0).
''']

  Indexes {
    status [type: btree, name: "template_version_status_idx"]
    (template_id, version) [type: btree, unique, name: "template_version_template_id_version_idx"]
  }
  Note: 'Toda evaluación referencia una template_version publicada (FK assessment.template_version_id).'
}

Table "evidence"."assessment_context" {
  "assessment_id" uuid [pk, not null, note: 'Relación 1:1 con assessment. Crear fila vacía al crear evaluación.']
  "mission" text
  "context_analysis" text
  "process_map" text
  "organigram" text
  "self_perception_concern" text [note: '¿Qué le preocupa a la entidad?']
  "self_perception_maturity" text [note: '¿En qué nivel de madurez considera estar?']
  "self_perception_phva_component" text [note: '¿En qué componente PHVA cree estar?']
  "updated_by" uuid
  "updated_at" timestamp [not null, default: `now()`]
  "version" integer [not null, default: 0, note: 'Versión para autoguardado del bloque contexto.']
  Note: '''HU-CFG-03/04: solo texto; no participa en cálculos numéricos (criterio 11).
Adjuntos HU-CFG-03: evidence.evidence_file con relation_type=CONTEXT,
relation_id=assessment_id, context_field=MISSION|CONTEXT_ANALYSIS|PROCESS_MAP|ORGANIGRAM.
MIME: pdf, docx, png, jpg, jpeg (validar contra admin.system_config evidence.allowedMimeTypes).
HU-CFG-04: comparación en reporte es responsabilidad de reporting (Módulo 8/9), datos aquí.
'''
}

Table "evidence"."evidence_file" {
  "id" uuid [pk, not null]
  "assessment_id" uuid
  "relation_type" "character varying(20)" [not null, note: '''CONTROL_RESPONSE (alias documental CONTROL) → relation_id = assessment_control_node.id
  Usado por HU-ADM-01 #25 y HU-TEC-01 #40 para adjuntos de evidencia del control.
LIFTING_DOC → relation_id = lifting_document_delivery.id
CONTEXT → relation_id = assessment.id (ver context_field)
GLOBAL | GAP_ACTION | REPORT_OUTPUT
''']
  "relation_id" uuid [not null, note: '''REPORT_OUTPUT → relation_id = reporting.report_generation_job.id (HU-REP-01/02/03/04).
GAP_ACTION → relation_id = assessment.gap_register.id
''']
  "context_field" "character varying(30)" [note: 'Solo si relation_type=CONTEXT: MISSION|CONTEXT_ANALYSIS|PROCESS_MAP|ORGANIGRAM']
  "filename" "character varying(260)" [not null]
  "content_type" "character varying(120)" [not null]
  "size_bytes" bigint [not null]
  "sha256" "character varying(80)" [not null]
  "bucket" "character varying(120)" [not null]
  "object_key" "character varying(500)" [not null]
  "uploaded_by" uuid [not null]
  "uploaded_at" timestamp [not null, default: `now()`]
  "deleted_at" timestamp

  Indexes {
    assessment_id [type: btree, name: "evidence_file_assessment_id_idx"]
    (assessment_id, relation_type) [type: btree, name: "evidence_file_assessment_id_relation_type_idx"]
    (assessment_id, relation_type, relation_id) [type: btree, name: "evidence_file_assessment_id_relation_type_relation_id_idx"]
    (relation_type, relation_id) [type: btree, name: "evidence_file_relation_type_relation_id_idx"]
    sha256 [type: btree, name: "evidence_file_sha256_idx"]
  }
  Note: '''Múltiples archivos por ítem de inventario (HU-CFG-05) vía LIFTING_DOC + mismo relation_id.
HU-REP-01..04: un evidence_file por report_generation_job completado (PDF o XLSX); content_type application/pdf
  o application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.
'''
}

