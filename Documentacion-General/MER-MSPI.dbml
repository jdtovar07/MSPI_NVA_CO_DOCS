// ============================
// MER - MSPI Platform (PostgreSQL, esquemas por microservicio)
// Generado desde MER-MSPI.sql consolidado (base + patch-*.sql del init Docker).
// Refleja el esquema real ejecutado: iam, org, catalog, assessment, evidence,
// reporting, audit, admin — incluye password_reset_request y request_number (SOL-*).
// ============================

Project MSPI_Platform {
  database_type: "PostgreSQL"
  Note: "Una sola instancia PostgreSQL. Ocho esquemas activos. Radicados legibles SOL-ELIM/SOL-AMPL/SOL-CAT/SOL-PWD. audit/admin sin FK cruzadas a iam/assessment."
}

Table "admin"."system_config" {
  "key" "character varying(120)" [pk, not null, note: '''Claves relevantes Módulo 1:
- evidence.allowedMimeTypes → ["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","image/png","image/jpeg"]
- evidence.maxFileSizeBytes
- assessment.autosaveIntervalSeconds
''']
  "value_json" jsonb [not null]
  "version" integer [not null, default: 1]
  "updated_by" uuid
  "updated_at" timestamp [not null, default: `now()`]
  Note: 'Configuración global (ms_admin :8089). updated_by UUID sin FK.'
}

Table "admin"."system_config_history" {
  "id" bigint [pk, not null]
  "key" "character varying(120)" [not null]
  "version" integer [not null]
  "value_json" jsonb [not null]
  "changed_by" uuid
  "changed_at" timestamp [not null, default: `now()`]
  "summary" "character varying(500)"

  Indexes {
    (key, changed_at) [type: btree, name: "idx_admin_system_config_history_key_changed"]
  }
  Note: 'Historial de configuración global; changed_by UUID sin FK.'
}

Table "assessment"."assessment" {
  "id" uuid [pk, not null]
  "organization_id" uuid [not null, note: 'Entidad evaluada. Validar en ms_org al crear.']
  "template_version_id" uuid [not null, note: 'Versión del instrumento MSPI aplicada.']
  "name" "character varying(220)" [not null, note: '''Título de la evaluación (ej. \'MSPI 2026 - Entidad X\')''']
  "organization_name_snapshot" "character varying(220)" [not null, note: 'Copia de org.name al crear. Cabecera en todas las pantallas.']
  "evaluation_date" date [not null, note: 'Fecha de evaluación diligenciada por el evaluador (HU-CFG-01 criterio 1).']
  "due_date" date [note: 'Fecha límite de la evaluación (created_at + assessmentDueDays); se amplía al aprobar una solicitud de ampliación.']
  "period_label" "character varying(120)" [note: '''Período de la evaluación ej. \'2025-Q1\', \'Vigencia 2026\' (HU-CFG-01: vinculada a entidad y período).''']
  "contact" "character varying(254)" [note: 'Contacto de la entidad para esta evaluación (HU-CFG-01 criterio 1).']
  "evaluator_display_name" "character varying(200)" [not null, note: 'Snapshot del nombre del evaluador líder al crear.']
  "prepared_by" "character varying(200)"
  "auditor_id" uuid
  "auditor_display_name" "character varying(200)"
  "created_by" uuid [not null, note: 'Evaluador que creó la evaluación (FK usuario).']
  "entity_order_type_code" "character varying(20)" [note: 'NACIONAL|TERRITORIAL_A|TERRITORIAL_B|TERRITORIAL_C|OTRA']
  "entity_type_other" "character varying(220)" [note: 'Texto libre obligatorio cuando entity_order_type_code = OTRA.']
  "phva_expected_advance_snapshot" numeric(5,4) [note: 'Copia de catalog.entity_order_type.phva_expected_advance al asignar/cambiar tipo.']
  "status" "character varying(30)" [not null, default: `'BORRADOR'::charactervarying`, note: '''BORRADOR | EN_DILIGENCIAMIENTO → editable (autoguardado)
EN_REVISION → revisión (módulos posteriores)
CERRADA → publicada, solo lectura (HU-CFG-01). Clonable.
''']
  "status_changed_at" timestamp
  "status_changed_by" uuid
  "published_at" timestamp [note: 'Momento de publicación (status=CERRADA).']
  "published_by" uuid
  "cloned_from_assessment_id" uuid [note: 'Origen si esta evaluación se creó por clonación (HU-CFG-01).']
  "priority" "character varying(10)" [not null, default: `'Media'::charactervarying`, note: 'Prioridad operativa: Alta | Media | Baja']
  "row_version" integer [not null, default: 0, note: 'Bloqueo optimista. Incrementar en cada PATCH; 409 si no coincide.']
  "last_saved_at" timestamp [note: 'Último autoguardado exitoso.']
  "deleted_at" timestamp [note: 'Borrado lógico: momento en que la evaluación fue eliminada tras aprobarse la solicitud y vencer el periodo de gracia. NULL = activa.']
  "updated_at" timestamp [not null, default: `now()`]
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    cloned_from_assessment_id [type: btree, name: "assessment_cloned_from_assessment_id_idx"]
    created_by [type: btree, name: "assessment_created_by_idx"]
    entity_order_type_code [type: btree, name: "assessment_entity_order_type_code_idx"]
    evaluation_date [type: btree, name: "assessment_evaluation_date_idx"]
    organization_id [type: btree, name: "assessment_organization_id_idx"]
    (organization_id, status) [type: btree, name: "assessment_organization_id_status_idx"]
    status [type: btree, name: "assessment_status_idx"]
    template_version_id [type: btree, name: "assessment_template_version_id_idx"]
  }
  Note: '''INICIALIZACIÓN OBLIGATORIA al crear (HU-CFG-01 criterio 2 — levantamiento vacío):
1. assessment (status=BORRADOR, snapshots de org y evaluador).
2. assessment_member (created_by como EVALUATOR, is_leader=true).
3. evidence.assessment_context (fila vacía, todos los textos NULL).
4. evidence.process_scope_metric (total=0, in_scope=0, coverage=NULL).
5. evidence.lifting_document_delivery × 43 (delivery_status=NOT_DELIVERED, sin archivos).
6. assessment_control_node + control_response por cada control hoja del template
   (score_status=PENDING, score_value=NULL — sin calificar; el progreso arranca en 0%).
7. assessment_phva_item por cada fila de catalog.phva_item_catalog del template
   (snapshot código, componente, scoring_mode, inherit_rule, origen).
8. phva_item_response solo para ítems scoring_mode=MANUAL
   (score_status=SCORED, score_value=0 — "requisitos PHVA manuales en cero").
9. assessment_maturity_requirement por cada fila de catalog.maturity_requirement_catalog
   (snapshot código, origen, scoring_mode, inherit_rule, referencias origen).
10. assessment_maturity_threshold por cada maturity_threshold del catálogo del template
    (copia level, is_na, expected_value — congela umbrales al crear evaluación).
11. assessment_maturity_requirement_response solo para scoring_mode=MANUAL
    (score_status=SCORED, score_value=0 — R5, R9, R10 en cero).
12. assessment_nist_ciber_item por cada fila de catalog.nist_ciber_item_catalog del template
    (snapshot función, subcategoría, scoring_mode, origen, iso_control_code, position).
13. nist_ciber_item_response solo para scoring_mode=MANUAL
    (score_status=SCORED, score_value=0 — requisitos NIST puros en cero).
Clonación (HU-CFG-01): copiar snapshots 7–13 + respuestas MANUAL/PHVA/Madurez/Ciber del origen.
Relaciones 1:1: assessment_context, process_scope_metric.
Varias evaluaciones por organization_id permitidas (regla de negocio HU-CFG-01).
'''
}

Table "assessment"."assessment_area" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "area_preset_code" "character varying(40)" [note: 'NULL si área manual o legado; recomendado llenar al crear desde preset.']
  "area_name" "character varying(160)" [not null]
  "description" "character varying(400)"
  "position" integer [not null, default: 0]
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    (assessment_id, area_name) [type: btree, unique, name: "assessment_area_assessment_id_area_name_idx"]
    (assessment_id, area_preset_code) [type: btree, name: "assessment_area_assessment_id_area_preset_code_idx"]
    assessment_id [type: btree, name: "assessment_area_assessment_id_idx"]
  }
  Note: '''Una fila por área institucional de la evaluación. UI lista las 8 áreas Excel vía preset + permite temas hijos assessment_area_topic.
'''
}

Table "assessment"."assessment_area_topic" {
  "id" uuid [pk, not null]
  "area_id" uuid [not null]
  "topic" "character varying(220)" [not null]
  "process_description" "character varying(400)" [note: 'HU-AR-01 criterio 20: proceso a cargo del líder de proceso.']
  "default_steward_role_code" "character varying(60)" [note: '''Si NULL, la fila es solo texto/tema sin participar en propagación masiva (#21).
Área "Líderes de proceso": varias filas mismo code LIDER_PROCESO con distinto process_description.
''']
  "staff_name" "character varying(200)"
  "staff_role" "character varying(160)" [note: 'Cargo texto captura (opcional diferencia respecto steward_role.label).']
  "staff_contact" "character varying(200)"
  "notes" "character varying(700)"
  "position" integer [not null, default: 0, note: 'Orden dentro del área; desempate al propagar si varias filas mismos default_steward_role_code.']

  Indexes {
    (area_id, default_steward_role_code) [type: btree, name: "assessment_area_topic_area_id_default_steward_role_code_idx"]
    area_id [type: btree, name: "assessment_area_topic_area_id_idx"]
    (area_id, position) [type: btree, name: "assessment_area_topic_area_id_position_idx"]
  }
  Note: '''Propagación (HU-AR-01 #21): al guardar, ms_assessment recalcula la persona efectiva en control_response
donde steward_source=FROM_AREA, assessment_id coincide y assessment_control_node.default_steward_role_code
igual a topic.default_steward_role_code (no NULL).
Ambigüedad (varias filas mismo código dentro de la evaluación): elegir determinísticamente, p. ej. mayor position
o updated_at más reciente; documentar regla única en app.
No persiste en control_response hasta M3 cuando existan filas assessment_control_node; puede materializarse
en tiempo de lectura (join) antes de ese snapshot si se desea MVP solo áreas (#18-20).
'''
}

Table "assessment"."assessment_control_node" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "source_catalog_node_id" uuid [not null]
  "parent_id" uuid
  "position" integer [not null]
  "node_type" "character varying(20)" [not null, note: 'DOMAIN | OBJECTIVE | SUB_OBJECTIVE | CONTROL (snapshot desde catálogo).']
  "control_type" "character varying(10)" [note: 'ADMIN | TECH — HU-TEC-01 filtra rama técnica en API.']
  "code" "character varying(40)"
  "iso_code" "character varying(40)" [note: 'HU-ADM-01 / HU-TEC-01 / HU-ADM-04: snapshot ISO 27001:2013 desde catalog.control_catalog_node.iso_code.']
  "title" "character varying(300)" [not null]
  "description" text
  "test_guidance" text
  "iso_domain_code" "character varying(20)"
  "mspi_tag" "character varying(120)"
  "ciber_tag" "character varying(120)" [note: 'Metadata Excel; evaluación NIST (M7) usa nist_ciber_item_catalog, no este campo.']
  "is_scored" boolean [not null, default: false]
  "rules_json" jsonb
  "default_steward_role_code" "character varying(60)" [note: 'Copia desde catalog.control_catalog_node al crear snapshot de evaluación (HU-AR-01).']

  Indexes {
    (assessment_id, code) [type: btree, unique, name: "assessment_control_node_assessment_id_code_idx"]
    (assessment_id, control_type) [type: btree, name: "assessment_control_node_assessment_id_control_type_idx"]
    assessment_id [type: btree, name: "assessment_control_node_assessment_id_idx"]
    (assessment_id, iso_code) [type: btree, name: "assessment_control_node_assessment_id_iso_code_idx"]
    (assessment_id, iso_domain_code) [type: btree, name: "assessment_control_node_assessment_id_iso_domain_code_idx"]
    (assessment_id, parent_id, position) [type: btree, name: "assessment_control_node_assessment_id_parent_id_position_idx"]
    (assessment_id, source_catalog_node_id) [type: btree, unique, name: "assessment_control_node_assessment_id_source_catalog_node_i_idx"]
  }
}

Table "assessment"."assessment_deletion_request" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "requested_by" uuid [not null]
  "requested_by_name" "character varying(200)"
  "reason" text [not null]
  "attachment_file_id" uuid
  "status" "character varying(20)" [not null, default: `'PENDING'::charactervarying`, note: 'PENDING|APPROVED|REJECTED|CANCELLED']
  "scheduled_deletion_at" timestamp [note: 'Fecha programada del borrado lógico (aprobación + assessmentDeletionGraceDays).']
  "decision_by" uuid
  "decision_by_name" "character varying(200)"
  "decision_at" timestamp
  "decision_comment" text
  "request_number" "character varying(32)" [unique, note: 'Código legible SOL-ELIM-###### (sin UUID).']
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    (assessment_id, status) [type: btree, name: "assessment_deletion_request_assessment_id_status_idx"]
    request_number [type: btree, unique, name: "assessment_deletion_request_number_uidx"]
  }
  Note: 'Solicitudes de eliminación (borrado lógico) de una evaluación, con aprobación y periodo de gracia.'
}

Table "assessment"."assessment_edit_lock" {
  "assessment_id" uuid [pk, not null]
  "locked_by_user_id" uuid [not null]
  "lock_token" uuid [not null, note: 'Token que el cliente debe enviar en cada PATCH.']
  "acquired_at" timestamp [not null, default: `now()`]
  "expires_at" timestamp [not null, note: 'TTL ej. 15-30 min; liberar al publicar o al cerrar sesión.']

  Indexes {
    expires_at [type: btree, name: "assessment_edit_lock_expires_at_idx"]
    locked_by_user_id [type: btree, name: "assessment_edit_lock_locked_by_user_id_idx"]
  }
  Note: '''HU-CFG-01 caso borde: dos evaluadores no editan a la vez.
Estrategia recomendada: row_version (optimista) en assessment + opcional esta tabla (pesimista).
Si no hay fila en edit_lock, solo aplica optimista. Si hay fila, solo locked_by puede editar hasta expires_at.
'''
}

Table "assessment"."assessment_extension_request" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "requested_by" uuid [not null]
  "requested_by_name" "character varying(200)"
  "reason" text [not null]
  "attachment_file_id" uuid
  "days" integer [not null, note: 'Días de ampliación (assessmentExtensionDays vigente al solicitar).']
  "status" "character varying(20)" [not null, default: `'PENDING'::charactervarying`, note: 'PENDING|APPROVED|REJECTED']
  "decision_by" uuid
  "decision_by_name" "character varying(200)"
  "decision_at" timestamp
  "decision_comment" text
  "request_number" "character varying(32)" [unique, note: 'Código legible SOL-AMPL-###### (sin UUID).']
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    (assessment_id, status) [type: btree, name: "assessment_extension_request_assessment_id_status_idx"]
    request_number [type: btree, unique, name: "assessment_extension_request_number_uidx"]
  }
  Note: 'Solicitudes de ampliación de plazo de una evaluación vencida o por vencer.'
}

Table "assessment"."assessment_maturity_requirement" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "source_catalog_requirement_id" uuid [not null]
  "code" "character varying(40)" [not null, note: 'Snapshot R1, R2, … R55']
  "title" "character varying(280)" [not null]
  "description" text
  "source_type" "character varying(12)" [not null, note: 'ADMIN|TECH|PHVA|MATURITY']
  "source_element_code" "character varying(40)" [not null]
  "scoring_mode" "character varying(12)" [not null, note: 'MANUAL|INHERITED']
  "inherit_rule" "character varying(24)" [not null, default: `'NONE'::charactervarying`]
  "source_control_code" "character varying(40)" [note: 'Código control origen ej. AD.4.1.1, T.7.1.4 (trazabilidad).']
  "source_catalog_control_node_id" uuid [note: 'Snapshot FK catálogo; resolver assessment_control_node en runtime.']
  "source_assessment_control_node_id" uuid [note: '''Opcional: materializar al crear evaluación si existe nodo control origen en snapshot de controles.
''']
  "source_phva_item_code" "character varying(40)"
  "composite_phva_codes" jsonb
  "source_catalog_phva_item_id" uuid [note: 'PHVA_ITEM_SCORE: ítem catálogo único.']
  "source_assessment_phva_item_id" uuid [note: '''Opcional: materializar FK PHVA al crear evaluación (un ítem). R41 usa composite_phva_codes on-read.
''']
  "position" integer [not null]

  Indexes {
    (assessment_id, source_catalog_requirement_id) [type: btree, unique, name: "assessment_maturity_requireme_assessment_id_source_catalog__idx"]
    (assessment_id, source_type, position) [type: btree, name: "assessment_maturity_requireme_assessment_id_source_type_pos_idx"]
    source_assessment_control_node_id [type: btree, name: "assessment_maturity_requireme_source_assessment_control_nod_idx"]
    source_assessment_phva_item_id [type: btree, name: "assessment_maturity_requireme_source_assessment_phva_item_i_idx"]
    (assessment_id, code) [type: btree, unique, name: "assessment_maturity_requirement_assessment_id_code_idx"]
    assessment_id [type: btree, name: "assessment_maturity_requirement_assessment_id_idx"]
    (assessment_id, scoring_mode) [type: btree, name: "assessment_maturity_requirement_assessment_id_scoring_mode_idx"]
  }
  Note: '''Una fila por requisito Rn del instrumento (~50 por evaluación).
INHERITED: UI solo lectura para F_n; effective_score (F_n) se calcula al listar/consolidar.
Resolución INHERITED:
  CONTROL_SCORE      → control_response del source_assessment_control_node (NA ⇒ F_n=N/A).
  PHVA_ITEM_SCORE    → effective_score del phva_item (manual o heredado M5).
  PHVA_COMPOSITE_AVG → avg(effective_score) de ítems listados en composite_phva_codes.
Si origen no resuelto (typo catálogo): error configuración en startup/seed, no en runtime silencioso.
Si F_n no disponible (#N/A Excel): API devuelve null + etiqueta "requiere calificación" (HU-MAD-01 #64).
'''
}

Table "assessment"."assessment_maturity_requirement_response" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "maturity_requirement_id" uuid [not null]
  "score_status" "character varying(10)" [not null, default: `'SCORED'::charactervarying`, note: '''HU-MAD-01 — SCORED | NA (misma escala 0–100 que controles/PHVA).
Al crear evaluación: solo MANUAL con SCORED y score_value=0.
''']
  "score_value" integer [note: '''0 | 20 | 40 | 60 | 80 | 100 cuando score_status=SCORED; NULL si NA.
F_n para MANUAL = score_value (o N/A si score_status=NA).
Validación contra catalog.scale_level al PATCH.
''']
  "updated_by" uuid
  "updated_at" timestamp [not null, default: `now()`]
  "version" integer [not null, default: 0]

  Indexes {
    (assessment_id, maturity_requirement_id) [type: btree, unique, name: "assessment_maturity_requireme_assessment_id_maturity_requir_idx"]
    (assessment_id, score_status) [type: btree, name: "assessment_maturity_requirement__assessment_id_score_status_idx"]
    assessment_id [type: btree, name: "assessment_maturity_requirement_response_assessment_id_idx"]
  }
  Note: '''1:1 con assessment_maturity_requirement donde scoring_mode=MANUAL (R5, R9, R10 en seed MSPI v1).
NO crear fila para INHERITED (F_n = función de control_response / PHVA on-read).
PATCH permitido solo en requisitos MANUAL; invalidar cache MATURITY si existe.
'''
}

Table "assessment"."assessment_maturity_threshold" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "maturity_requirement_id" uuid [not null]
  "level" integer [not null, note: '1..5']
  "is_na" boolean [not null, default: false]
  "expected_value" integer [note: 'NULL si is_na=true']

  Indexes {
    assessment_id [type: btree, name: "assessment_maturity_threshold_assessment_id_idx"]
    (assessment_id, level) [type: btree, name: "assessment_maturity_threshold_assessment_id_level_idx"]
    (maturity_requirement_id, level) [type: btree, unique, name: "assessment_maturity_threshold_maturity_requirement_id_level_idx"]
  }
  Note: '''Copia de catalog.maturity_threshold al crear/clonar evaluación (HU-CFG-01).
nivelCumple(L) y matriz HU-MAD-02 usan solo filas con is_na=false para el nivel L.
'''
}

Table "assessment"."assessment_member" {
  "assessment_id" uuid [not null]
  "user_id" uuid [not null]
  "member_role" "character varying(20)" [not null, note: 'EVALUATOR|REVIEWER|READER']
  "is_leader" boolean [not null, default: false, note: 'true = evaluador líder (HU-CFG-01)']
  "assigned_at" timestamp [not null, default: `now()`]

  Indexes {
    (assessment_id, member_role) [type: btree, name: "assessment_member_assessment_id_member_role_idx"]
    (assessment_id, user_id) [type: btree, unique, name: "assessment_member_assessment_id_user_id_idx"]
    user_id [type: btree, name: "assessment_member_user_id_idx"]
  }
  Note: 'Equipo de la evaluación. El líder suele coincidir con created_by.'
}

Table "assessment"."assessment_metadata" {
  "assessment_id" uuid [pk, not null]
  "period" "character varying(120)" [note: 'Período fiscal o vigencia (complementario a evaluation_date)']
  "scope" text
  "prepared_by" "character varying(200)"
  "approved_by" "character varying(200)"
  "start_date" date [note: 'Rango complementario; NO reemplaza evaluation_date de assessment.']
  "end_date" date
  "notes" text
  Note: 'Metadatos extendidos. row_version de concurrencia está en assessment.assessment.row_version.'
}

Table "assessment"."assessment_nist_ciber_item" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "source_catalog_item_id" uuid [not null]
  "function_id" uuid [not null, note: 'Snapshot función NIST (agrupación promedios).']
  "function_code" "character varying(20)" [not null, note: 'Snapshot GV|ID|PR|DE|RS|RC (CSF 2.0) — denormalizado para API.']
  "function_name" "character varying(120)" [note: 'Snapshot nombre de función NIST (p. ej. Gobernar) — denormalizado del catálogo.']
  "subcategory_id" uuid [not null]
  "subcategory_code" "character varying(40)" [not null, note: 'Snapshot ID.AM-1, PR.AC-1, …']
  "title" "character varying(300)"
  "scoring_mode" "character varying(12)" [not null, note: 'MANUAL|INHERITED']
  "source_type" "character varying(12)" [not null, note: 'ADMIN|TECH|NIST']
  "inherit_rule" "character varying(24)" [not null, default: `'NONE'::charactervarying`]
  "iso_control_code" "character varying(80)" [note: 'NULL en filas MANUAL puras NIST.']
  "source_catalog_control_node_id" uuid [note: 'FK catálogo control hoja; resolver assessment_control_node en runtime.']
  "source_assessment_control_node_id" uuid [note: '''Opcional: materializar al crear evaluación si existe nodo control origen en snapshot de controles.
''']
  "position" integer [not null]

  Indexes {
    (assessment_id, function_code, position) [type: btree, name: "assessment_nist_ciber_item_assessment_id_function_code_posi_idx"]
    assessment_id [type: btree, name: "assessment_nist_ciber_item_assessment_id_idx"]
    (assessment_id, position) [type: btree, unique, name: "assessment_nist_ciber_item_assessment_id_position_idx"]
    (assessment_id, scoring_mode) [type: btree, name: "assessment_nist_ciber_item_assessment_id_scoring_mode_idx"]
    (assessment_id, source_catalog_item_id) [type: btree, unique, name: "assessment_nist_ciber_item_assessment_id_source_catalog_ite_idx"]
    (assessment_id, source_type) [type: btree, name: "assessment_nist_ciber_item_assessment_id_source_type_idx"]
    (assessment_id, subcategory_code) [type: btree, name: "assessment_nist_ciber_item_assessment_id_subcategory_code_idx"]
    source_assessment_control_node_id [type: btree, name: "assessment_nist_ciber_item_source_assessment_control_node_i_idx"]
  }
  Note: '''Una fila por ítem Ciber del instrumento (~188 por evaluación en MSPI v1).
INHERITED: UI solo lectura; effective_score (c_i) = score del control hoja (NA ⇒ N/A, excluido del promedio).
MANUAL: editable vía nist_ciber_item_response.
Si control origen sin calificar: effective_score null + requiresRating=true (no error Excel #N/A).
Invalidar cache NIST al cambiar control_response o nist_ciber_item_response MANUAL.
'''
}

Table "assessment"."assessment_phva_item" {
  "id" uuid [pk, not null]
  "assessment_id" uuid [not null]
  "source_catalog_item_id" uuid [not null]
  "code" "character varying(40)" [not null, note: 'Snapshot P.1, I.2, E.1, M.1, …']
  "component" "character varying(10)" [not null, note: 'PLAN|DO|CHECK|ACT']
  "title" "character varying(280)" [not null]
  "description" text
  "test_guidance" text
  "scoring_mode" "character varying(12)" [not null, note: 'MANUAL|INHERITED — copia desde catálogo al crear evaluación.']
  "inherit_rule" "character varying(24)" [not null, default: `'NONE'::charactervarying`, note: 'NONE|CONTROL_SCORE|CONTROL_ROLLUP|ANEXO_A_OVERALL']
  "source_control_code" "character varying(40)"
  "source_catalog_control_node_id" uuid [note: 'Snapshot FK catálogo; resolver a assessment_control_node en runtime.']
  "source_assessment_control_node_id" uuid [note: '''Opcional: FK materializada al crear evaluación si existe nodo control origen en el snapshot de controles.
Si NULL, resolver on-read por source_catalog_control_node_id + assessment_id.
''']
  "position" integer [not null]
  "parent_code" "character varying(40)"
  "node_type" "character varying(12)" [not null, default: `'ITEM'::charactervarying`]

  Indexes {
    (assessment_id, code) [type: btree, unique, name: "assessment_phva_item_assessment_id_code_idx"]
    (assessment_id, component, position) [type: btree, name: "assessment_phva_item_assessment_id_component_position_idx"]
    assessment_id [type: btree, name: "assessment_phva_item_assessment_id_idx"]
    (assessment_id, scoring_mode) [type: btree, name: "assessment_phva_item_assessment_id_scoring_mode_idx"]
    (assessment_id, source_catalog_item_id) [type: btree, unique, name: "assessment_phva_item_assessment_id_source_catalog_item_id_idx"]
    source_assessment_control_node_id [type: btree, name: "assessment_phva_item_source_assessment_control_node_id_idx"]
  }
  Note: '''Una fila por requisito PHVA del instrumento (~17 por evaluación).
INHERITED: UI solo lectura; effective_score se calcula al listar/consolidar (no persiste en phva_item_response).
Resolución INHERITED:
  CONTROL_SCORE  → control_response.score_value del source_assessment_control_node (hoja).
  CONTROL_ROLLUP → rollup del nodo ADMIN referenciado (objetivo/dominio según seed).
  ANEXO_A_OVERALL→ promedio global Anexo A (rollup ADMIN ∪ TECH a nivel raíz; ver HU-DIAG-01).
'''
}

