    (status, scheduled_deletion_at) [type: btree, name: "catalog_deletion_request_status_scheduled_idx"]
    (target_type, target_id, status) [type: btree, name: "catalog_deletion_request_target_status_idx"]
    (target_type, target_id, status) [type: btree, name: "catalog_deletion_request_target_type_target_id_status_idx"]
  }
  Note: 'Solicitudes de eliminación lógica de escalas o bancos de preguntas.'
}

Table "catalog"."control_catalog_node" {
  "id" uuid [pk, not null]
  "template_version_id" uuid [not null]
  "parent_id" uuid
  "position" integer [not null]
  "node_type" "character varying(20)" [not null, note: '''DOMAIN | OBJECTIVE | SUB_OBJECTIVE | CONTROL.
ADMIN (M3): DOMAIN → OBJECTIVE → CONTROL (3 niveles; AD.x.y.z en hoja).
TECH (M4): DOMAIN → OBJECTIVE → SUB_OBJECTIVE → CONTROL (4 niveles cuando aplica; T.x.y.z en hoja).
Alternativa válida: OBJECTIVE anidado (padre OBJECTIVE → hijo OBJECTIVE) sin SUB_OBJECTIVE explícito;
el rollup solo usa parent_id + is_scored, no el nombre del tipo.
''']
  "control_type" "character varying(10)" [note: 'ADMIN | TECH. Aplica a nodos de la rama; en hojas is_scored=true típicamente.']
  "code" "character varying(40)" [note: '''ID interno MSPI (no confundir con iso_code):
ADMIN: AD.x (dominio), AD.x.y (objetivo), AD.x.y.z (hoja).
TECH:  T.x (dominio), T.x.y (objetivo), T.x.y.z (sub-objetivo o hoja según profundidad del dominio).
HU-TEC-01 #41: prefijo T. HU-TEC-01 #42: ISO en iso_code (A.9.x.y, A.10.x.y, …).
''']
  "iso_code" "character varying(40)" [note: '''HU-ADM-01 / HU-TEC-01 + HU-ADM-04: referencia ISO 27001:2013 específica del nodo.
Ej. A.5.1.1 en control hoja, A.5.1 en objetivo, A.5 en dominio.
Distinto de iso_domain_code (que solo apunta al dominio raíz) y de code (ID interno AD/T).
''']
  "title" "character varying(300)" [not null]
  "description" text
  "test_guidance" text
  "iso_domain_code" "character varying(20)"
  "mspi_tag" "character varying(120)"
  "ciber_tag" "character varying(120)" [note: 'Metadata Excel; evaluación NIST (M7) usa nist_ciber_item_catalog, no este campo.']
  "is_scored" boolean [not null, default: false]
  "default_steward_role_code" "character varying(60)" [note: '''HU-ADM-01 / HU-TEC-01 + HU-AR-01: cargo predeterminado del control (hoja ISO). Solo control_type ADMIN|TECH en nodos CONTROL hoja típicamente.
NULL en secciones o nodos sin responsable definido en Excel.
''']
  "created_at" timestamp [not null, default: `now()`]

  Indexes {
    (template_version_id, code) [type: btree, unique, name: "control_catalog_node_template_version_id_code_idx"]
    template_version_id [type: btree, name: "control_catalog_node_template_version_id_idx"]
    (template_version_id, iso_code) [type: btree, name: "control_catalog_node_template_version_id_iso_code_idx"]
    (template_version_id, iso_domain_code) [type: btree, name: "control_catalog_node_template_version_id_iso_domain_code_idx"]
    (template_version_id, parent_id, position) [type: btree, name: "control_catalog_node_template_version_id_parent_id_position_idx"]
  }
  Note: '''HU-ADM-02 / HU-ADM-03 / HU-TEC-02 — Reglas de cálculo (en código, sin tabla extra):
  calcular(nodo):
    si nodo.es_hoja (is_scored=true)           → control_response.score_value (N/A excluido)
    si nodo tiene un único hijo                → calcular(hijo) (sin redondeo)
    si nodo tiene varios hijos                 → round_half_up(avg([calcular(h) for h in hijos]))
  Reglas:
    * Excluir hijos cuyo cálculo retorne N/A; si TODOS son N/A, el nodo es N/A.
    * round_half_up: floor(x + 0.5).
    * Dominio promedia hijos directos (objetivos en ADMIN; objetivos en TECH) — no hojas en un salto.
    * HU-TEC-02 #43-45: misma función recursiva; TECH puede tener SUB_OBJECTIVE intermedio (ej. A.9.3 → A.9.3.1).
  API rollup: filtrar assessment_control_node por control_type=ADMIN|TECH antes de calcular raíces.
  Cache opcional: reporting.analytics_cache kind IN (\'ROLLUP\',\'ROLLUP_ADMIN\',\'ROLLUP_TECH\').
'''
}

Table "catalog"."control_rule" {
  "id" uuid [pk, not null]
  "control_node_id" uuid [unique, not null]
  "requires_evidence" boolean [not null, default: false]
  "requires_gap" boolean [not null, default: false]
  "requires_recommendation" boolean [not null, default: false]
  "recommendation_rule_type" "character varying(20)" [not null, default: `'THRESHOLD'::charactervarying`, note: 'ALWAYS|THRESHOLD|NEVER']
  "recommendation_threshold_value" integer
  "requires_test_checklist" boolean [not null, default: false]
  "max_files" integer
  "max_text_len" jsonb
  Note: '''Una fila por control hoja (ADMIN o TECH). HU-ADM-01 #25 y HU-TEC-01 #40 comparten reglas.
Seed: generar por cada nodo con is_scored=true y control_type IN (ADMIN, TECH).
'''
}

Table "catalog"."entity_order_type" {
  "code" "character varying(20)" [pk, not null, note: 'NACIONAL|TERRITORIAL_A|TERRITORIAL_B|TERRITORIAL_C|OTRA']
  "label" "character varying(80)" [not null]
  "phva_expected_advance" numeric(5,4) [not null, note: '''Fracción 0..1. Ejemplos documentados:
- NACIONAL = 0.40 (40%)
- TERRITORIAL_A = 0.35 (35%)
- TERRITORIAL_B/C = confirmar con política MinTIC antes de seed.
''']
  "position" integer [not null, note: 'Orden de presentación en UI']
  "active" boolean [not null, default: true]
  Note: '''HU-CFG-02: 4 tipos oficiales MSPI (NACIONAL, TERRITORIAL_A, TERRITORIAL_B, TERRITORIAL_C) + OTRA (texto libre en assessment.entity_type_other).
Seed obligatorio. Territorial B/C: confirmar phva_expected_advance con MinTIC.
assessment guarda snapshot en phva_expected_advance_snapshot al asignar o cambiar tipo.
Regla app: entity_order_type_code obligatorio antes de publicar (status=CERRADA); si OTRA, entity_type_other obligatorio.
'''
}

Table "catalog"."iso_domain" {
  "code" "character varying(20)" [pk, not null, note: '''Dominios ISO 27001:2013 del instrumento MSPI (14 dominios — HU-DIAG-01 #91).
Administrativos (M3 / HU-DIAG-01 #94): A.5, A.6, A.7, A.8, A.15, A.17, A.18.
Técnicos (M4 / HU-DIAG-01 #94): A.9, A.10, A.11, A.12, A.13, A.14, A.16.
Debe existir exactamente un nodo control_catalog_node.node_type=DOMAIN por (template, iso_domain_code, control_type).
''']
  "name" "character varying(220)" [not null, note: 'Nombre legible en tablero Portada (columna dominio).']
  "description" "character varying(600)"
  "control_type" "character varying(10)" [not null, note: 'ADMIN | TECH — hoja origen del dominio (HU-DIAG-01 #94).']
  "display_position" integer [not null, note: '''Orden de fila en Portada Excel (F19..F32). Seed sugerido:
ADMIN: A.5=1, A.6=2, A.7=3, A.8=4, A.15=5, A.17=6, A.18=7.
TECH:  A.9=8, A.10=9, A.11=10, A.12=11, A.13=12, A.14=13, A.16=14.
''']
  "active" boolean [not null, default: true]

  Indexes {
    active [type: btree, name: "iso_domain_active_idx"]
    (control_type, display_position) [type: btree, name: "iso_domain_control_type_display_position_idx"]
  }
}

Table "catalog"."lifting_document_item_catalog" {
  "id" uuid [pk, not null]
  "template_version_id" uuid [not null]
  "item_number" integer [not null, note: '1..43. Ítem 43 = métrica de procesos MSPI.']
  "block" "character varying(30)" [not null, note: '''Bloque según Excel:
- BASICA (ítems 1-34)
- IMPLEMENTACION (35-37)
- EVALUACION (38-40)
- MEJORA_CONTINUA (41-43)
''']
  "title" "character varying(300)" [not null, note: 'Nombre/descripción del documento solicitado']
  "required_text" text [not null, note: 'Texto oficial del requisito (paridad Excel)']
  "hints" text
  "is_required" boolean [not null, default: true]
  "is_process_metric" boolean [not null, default: false, note: 'true solo item_number=43']
  "position" integer [not null, note: 'Orden dentro del bloque (mayor importancia = menor position; menor position = más importante)']

  Indexes {
    (template_version_id, block, position) [type: btree, name: "lifting_document_item_catalog_template_version_id_block_pos_idx"]
    (template_version_id, item_number) [type: btree, unique, name: "lifting_document_item_catalog_template_version_id_item_numb_idx"]
  }
  Note: '''HU-CFG-05: por template_version publicada deben existir exactamente 43 filas.
Rangos de item_number por block (validar en seed y en app):
  BASICA → 1..34 | IMPLEMENTACION → 35..37 | EVALUACION → 38..40 | MEJORA_CONTINUA → 41..43
item_number=43 → is_process_metric=true; datos numéricos en evidence.process_scope_metric.
'''
}

Table "catalog"."lifting_question_catalog" {
  "id" uuid [pk, not null]
  "template_version_id" uuid [not null]
  "code" "character varying(40)" [not null]
  "section" "character varying(120)"
  "question_text" text [not null]
  "field_type" "character varying(30)" [not null, note: 'TEXT|TEXTAREA|NUMBER|SELECT|MULTISELECT|DATE']
  "is_required" boolean [not null, default: false]
  "position" integer [not null]
  "options_json" jsonb

  Indexes {
    (template_version_id, code) [type: btree, unique, name: "lifting_question_catalog_template_version_id_code_idx"]
    (template_version_id, section) [type: btree, name: "lifting_question_catalog_template_version_id_section_idx"]
  }
  Note: 'Complementario. HU-CFG-03/04 usan evidence.assessment_context como fuente principal.'
}

Table "catalog"."maturity_requirement_catalog" {
  "id" uuid [pk, not null]
  "template_version_id" uuid [not null]
  "code" "character varying(40)" [not null, note: 'R1..R55 (Anexo A MSPI v1: ~50 filas Rn; sin R54).']
  "title" "character varying(280)" [not null]
  "description" text
  "source_type" "character varying(12)" [not null, note: '''ADMIN | TECH | PHVA | MATURITY — hoja origen (HU-MAD-01 #60).
ADMIN/TECH → inherit_rule=CONTROL_SCORE.
PHVA       → PHVA_ITEM_SCORE o PHVA_COMPOSITE_AVG.
MATURITY   → scoring_mode=MANUAL (R5, R9, R10).
''']
  "source_element_code" "character varying(40)" [not null, note: '''Elemento en hoja origen: AD.4.1.1, T.7.1.4, P.6, R5, I.5+E.1+… (trazabilidad Excel/VLOOKUP).
Para MATURITY manual suele coincidir con code (R5, R9) o etiqueta Excel (R10→R9).
''']
  "scoring_mode" "character varying(12)" [not null, default: `'INHERITED'::charactervarying`, note: '''INHERITED → F_n derivado on-read; sin PATCH de score en Madurez.
MANUAL    → evaluador califica en hoja Madurez (maturity_requirement_response).
''']
  "inherit_rule" "character varying(24)" [not null, default: `'NONE'::charactervarying`, note: '''NONE               → scoring_mode=MANUAL.
CONTROL_SCORE      → F_n = control_response.score_value del control hoja (ADMIN o TECH).
PHVA_ITEM_SCORE    → F_n = effective_score de assessment_phva_item (source_phva_item_code).
PHVA_COMPOSITE_AVG → F_n = round_half_up(avg(effective_score)) sobre composite_phva_codes (R41).
''']
  "source_control_node_id" uuid [note: '''CONTROL_SCORE: nodo hoja en catálogo (control_type ADMIN o TECH según source_type).
En evaluación: resolver assessment_control_node por source_catalog_node_id.
''']
  "source_phva_item_code" "character varying(40)" [note: 'PHVA_ITEM_SCORE: P.1, P.6, P.8, M.2, … (un solo ítem PHVA).']
  "composite_phva_codes" jsonb [note: '''PHVA_COMPOSITE_AVG: array JSON ordenado de códigos PHVA.
Seed R41: ["I.5","E.1","E.2","E.3","M.1"] — promedio de effective_score (excl. NA).
''']
  "position" integer [not null]
  "active" boolean [not null, default: true]

  Indexes {
    source_control_node_id [type: btree, name: "maturity_requirement_catalog_source_control_node_id_idx"]
    (template_version_id, code) [type: btree, unique, name: "maturity_requirement_catalog_template_version_id_code_idx"]
    (template_version_id, scoring_mode) [type: btree, name: "maturity_requirement_catalog_template_version_id_scoring_mo_idx"]
    (template_version_id, source_type, position) [type: btree, name: "maturity_requirement_catalog_template_version_id_source_typ_idx"]
  }
  Note: '''HU-MAD-01..02 — catálogo paramétrico hoja Madurez (~50 requisitos por template_version publicada).
Fuente de verdad umbrales: maturity_threshold (5 filas por requisito, is_na donde Excel dice N/A).
Orígenes manuales (seed): R5, R9, R10 — source_type=MATURITY, scoring_mode=MANUAL, inherit_rule=NONE.
Orígenes PHVA (ej.): R4,R7→P.1; R11→P.6; R40→P.8; R46→M.2; R41→PHVA_COMPOSITE_AVG.
Validación app:
  inherit_rule=NONE ⇒ scoring_mode=MANUAL y source_type=MATURITY.
  CONTROL_SCORE ⇒ source_control_node_id NOT NULL y source_type IN (ADMIN,TECH).
  PHVA_ITEM_SCORE ⇒ source_phva_item_code NOT NULL y source_type=PHVA.
  PHVA_COMPOSITE_AVG ⇒ composite_phva_codes NOT NULL (array no vacío).
Sub-filas auxiliares del Excel (debajo de R4, R41) NO se modelan como filas BD en v1;
  solo las filas Rn del Anexo A Historias v2. Diferencia documentada vs conteo Excel Portada.
'''
}

Table "catalog"."maturity_requirement_control_map" {
  "id" uuid [pk, not null]
  "requirement_id" uuid [not null]
  "control_node_id" uuid [not null]

  Indexes {
    (requirement_id, control_node_id) [type: btree, unique, name: "maturity_requirement_control__requirement_id_control_node_i_idx"]
    requirement_id [type: btree, name: "maturity_requirement_control_map_requirement_id_idx"]
  }
  Note: '''Enlace explícito requisito ↔ control (trazabilidad). Implementación v1: preferir
maturity_requirement_catalog.source_control_node_id (1:1). Esta tabla es opcional
para seeds que prefieren normalizar el mapa; debe ser coherente con source_control_node_id.
'''
}

Table "catalog"."maturity_threshold" {
  "id" uuid [pk, not null]
  "requirement_id" uuid [not null]
  "level" integer [not null, note: '1..5 — N1 Inicial … N5 Optimizado']
  "is_na" boolean [not null, default: false, note: '''TRUE → celda N/A (requisito no se evalúa en este nivel; HU-MAD-02 #67).
FALSE → expected_value obligatorio (0|20|40|60|80|100 según escala).
''']
  "expected_value" integer [note: '''Umbral U_{n,L} del Excel. NULL cuando is_na=true.
CHECK app: (is_na AND expected_value IS NULL) OR (NOT is_na AND expected_value IS NOT NULL).
''']

  Indexes {
    (requirement_id, level) [type: btree, unique, name: "maturity_threshold_requirement_id_level_idx"]
  }
  Note: '''HU-MAD-02 — matriz de umbrales. Participación en nivelCumple(L):
  solo requisitos n con fila (n,L) donde is_na=false.
estado(F_n,U): si is_na o F_n es N/A → celda N/A; si F_n null sin calificar → tratar como 0 o
  mensaje "requiere calificación" (HU-MAD-01 #64) según política UI.
'''
}

Table "catalog"."nist_ciber_item_catalog" {
  "id" uuid [pk, not null]
  "template_version_id" uuid [not null]
  "function_id" uuid [not null, note: '''Denormalizado desde nist_subcategory.function_id — acelera agrupación HU-CIB-02.
Debe coincidir con la función de subcategory_id.
''']
  "subcategory_id" uuid [not null]
  "title" "character varying(300)" [note: 'Texto fila Ciber / descripción corta (opcional; UI puede usar subcategory.description).']
  "scoring_mode" "character varying(12)" [not null, default: `'INHERITED'::charactervarying`, note: '''INHERITED → calificación on-read desde control hoja (HU-CIB-01 #81).
MANUAL    → calificación en hoja Ciber (HU-CIB-01 #82) — requisitos 100% NIST sin ISO.
''']
  "source_type" "character varying(12)" [not null, note: '''ADMIN | TECH | NIST — hoja origen (HU-CIB-01 #80).
NIST  → solo cuando scoring_mode=MANUAL (sin control ISO).
ADMIN/TECH → scoring_mode=INHERITED con source_control_node_id.
''']
  "inherit_rule" "character varying(24)" [not null, default: `'NONE'::charactervarying`, note: '''NONE           → scoring_mode=MANUAL.
CONTROL_SCORE  → F_i = control_response.score_value del control hoja (réplica VLOOKUP Administrativas/Técnicas).
''']
  "source_control_node_id" uuid [note: '''CONTROL_SCORE: nodo hoja en catálogo (control_type ADMIN o TECH según source_type).
En evaluación: resolver assessment_control_node por source_catalog_node_id.
NULL cuando scoring_mode=MANUAL (subcategoría NIST pura).
''']
  "iso_control_code" "character varying(80)" [note: '''Referencia ISO 27001 (A.5.1.1, …) para filas INHERITED — columna C Excel / trazabilidad.
NULL en filas MANUAL puras NIST.
''']
  "position" integer [not null, note: '''Orden de fila en hoja Ciber (1..~201). Filas 1–13 típicamente MANUAL; 26–201 INHERITED.
Filas 14–25 reservadas/vacías en Excel original — no sembrar o marcar inactive si no aplican.
''']
  "active" boolean [not null, default: true]

  Indexes {
    source_control_node_id [type: btree, name: "nist_ciber_item_catalog_source_control_node_id_idx"]
    subcategory_id [type: btree, name: "nist_ciber_item_catalog_subcategory_id_idx"]
    (template_version_id, function_id, position) [type: btree, name: "nist_ciber_item_catalog_template_version_id_function_id_pos_idx"]
    (template_version_id, position) [type: btree, unique, name: "nist_ciber_item_catalog_template_version_id_position_idx"]
    (template_version_id, scoring_mode) [type: btree, name: "nist_ciber_item_catalog_template_version_id_scoring_mode_idx"]
    (template_version_id, source_type) [type: btree, name: "nist_ciber_item_catalog_template_version_id_source_type_idx"]
    (template_version_id, subcategory_id, source_control_node_id) [type: btree, unique, name: "nist_ciber_item_catalog_template_version_id_subcategory_id__idx"]
  }
  Note: '''HU-CIB-01..03 — fuente de verdad de la hoja Ciber por instrumento publicado.
Paridad Excel MSPI v1:
  ~13 filas NIST puras (MANUAL, source_type=NIST, ej. ID.GV-4 sin A.x.y.z).
  ~175 filas con VLOOKUP a Administrativas/Técnicas (INHERITED, iso_control_code + control hoja).
Un control ISO puede generar varias filas (varias subcategorías / funciones); misma calificación en todas.
Promedio por función (HU-CIB-02): avg sobre todas las filas activas de la función con score calculable (excl. NA);
  cada fila del catálogo cuenta en su función (réplica filas repetidas del Excel, no deduplicar por control).
Validación app al publicar template:
  MANUAL ⇒ inherit_rule=NONE, source_type=NIST, source_control_node_id IS NULL.
  INHERITED ⇒ inherit_rule=CONTROL_SCORE, source_type IN (ADMIN,TECH), source_control_node_id NOT NULL.
  function_id = subcategory.function_id.
Coherencia: por cada fila INHERITED existe fila equivalente en nist_mapping (opcional script de validación).
'''
}

Table "catalog"."nist_function" {
  "id" uuid [pk, not null]
  "code" "character varying(20)" [unique, not null, note: '''ID = Identificar | PR = Proteger | DE = Detectar | RS = Responder | RC = Recuperar.
HU-CIB-01 #80 — cinco funciones del NIST CSF.
''']
  "name" "character varying(120)" [not null, note: 'Nombre en español para UI (Identificar, Proteger, …).']
  "position" integer [not null, default: 0, note: 'Orden de presentación en tablero/radar (1..5).']
  Note: '''Catálogo global de funciones NIST (no varía por template_version).
Agrupación HU-CIB-02: promedio(f) sobre filas cuya subcategoría pertenece a function_id.
'''
}

Table "catalog"."nist_mapping" {
  "id" uuid [pk, not null]
  "template_version_id" uuid [not null]
  "subcategory_id" uuid [not null]
  "control_node_id" uuid [note: '''Control hoja ADMIN o TECH (is_scored=true). NULL solo si fila es subcategoría NIST sin ISO (no aplica aquí;
esas filas viven solo en nist_ciber_item_catalog con scoring_mode=MANUAL).
''']
  "iso_control_code" "character varying(80)" [note: 'A.x.y.z — clave VLOOKUP Excel (columna C hoja Ciber).']

  Indexes {
    (template_version_id, control_node_id) [type: btree, name: "nist_mapping_template_version_id_control_node_id_idx"]
    template_version_id [type: btree, name: "nist_mapping_template_version_id_idx"]
    (template_version_id, subcategory_id, control_node_id) [type: btree, unique, name: "nist_mapping_template_version_id_subcategory_id_control_nod_idx"]
    (template_version_id, subcategory_id) [type: btree, name: "nist_mapping_template_version_id_subcategory_id_idx"]
  }
  Note: '''Trazabilidad control ↔ subcategoría para detalle de control (HU-ADM-04 #38) y seeds.
Debe ser coherente con filas INHERITED de nist_ciber_item_catalog (mismo template, subcategory, control).
NO sustituye el catálogo de filas Ciber: la evaluación y promedios usan nist_ciber_item_catalog + snapshot.
'''
}

Table "catalog"."nist_subcategory" {
  "id" uuid [pk, not null]
  "function_id" uuid [not null]
  "code" "character varying(40)" [unique, not null, note: 'ID.AM-1, PR.AC-1, DE.CM-1, RS.RP-1, RC.RP-1, …']
  "description" text
  "active" boolean [not null, default: true]

  Indexes {
    (function_id, code) [type: btree, unique, name: "nist_subcategory_function_id_code_idx"]
    function_id [type: btree, name: "nist_subcategory_function_id_idx"]
  }
  Note: '''Subcategorías NIST CSF referenciadas por la hoja Ciber.
Un mismo iso_control_code puede mapear a varias subcategorías (varias filas Ciber).
'''
}

Table "catalog"."phva_item_catalog" {
  "id" uuid [pk, not null]
  "template_version_id" uuid [not null]
  "code" "character varying(40)" [not null, note: 'P.1, P.2, I.2, E.1, M.1, … (~17 requisitos por template publicado).']
  "component" "character varying(10)" [not null, note: '''PLAN | DO | CHECK | ACT
PLAN = Planificación (peso 40) | DO = Implementación (20) | CHECK = Evaluación desempeño (20) | ACT = Mejora (20)
''']
  "title" "character varying(280)" [not null]
  "description" text
  "test_guidance" text
  "scoring_mode" "character varying(12)" [not null, default: `'MANUAL'::charactervarying`, note: '''MANUAL    → evaluador califica en hoja PHVA (phva_item_response).
INHERITED → solo lectura; valor derivado on-read (sin PATCH de score).
''']
  "inherit_rule" "character varying(24)" [not null, default: `'NONE'::charactervarying`, note: '''NONE              → scoring_mode=MANUAL (sin origen externo).
CONTROL_SCORE     → copiar score de control hoja ADMIN (source_control_node_id = hoja).
CONTROL_ROLLUP    → copiar promedio rollup del nodo ADMIN interno (objetivo/dominio; source = nodo padre).
ANEXO_A_OVERALL   → promedio total Anexo A ADMIN+TECH (solo I.2; HU-PHVA-02 / HU-DIAG-01).
''']
  "source_control_code" "character varying(40)" [note: 'Código instrumento origen ej. AD.1, AD.2.1.1, AD.4.1.1, AD.3.2.2 (trazabilidad Excel).']
  "source_control_node_id" uuid [note: '''Nodo catálogo origen para INHERITED (CONTROL_SCORE o CONTROL_ROLLUP).
En evaluación se resuelve vía assessment_control_node.source_catalog_node_id.
''']
  "position" integer [not null]
  "active" boolean [not null, default: true]
  "parent_code" "character varying(40)"
  "node_type" "character varying(12)" [not null, default: `'ITEM'::charactervarying`]

  Indexes {
    (template_version_id, code) [type: btree, unique, name: "phva_item_catalog_template_version_id_code_idx"]
    (template_version_id, component, position) [type: btree, name: "phva_item_catalog_template_version_id_component_position_idx"]
    (template_version_id, scoring_mode) [type: btree, name: "phva_item_catalog_template_version_id_scoring_mode_idx"]
  }
  Note: '''HU-PHVA-01..04 — catálogo paramétrico de la hoja PHVA (~17 filas por template_version).
Seed MSPI v1 (referencia Historias v2):
  PLAN (8 en promedio): P.1 MANUAL; P.2 INHERITED CONTROL_ROLLUP→AD.1; P.3 MANUAL; P.4→AD.2.1.1;
    P.5→AD.4.1.1; P.6 MANUAL; P.8 MANUAL; P.9→AD.3.2.2  (P.7 no aplica en promedio documentado).
  DO (4): I.1,I.3,I.4 MANUAL; I.2 INHERITED ANEXO_A_OVERALL.
  CHECK (3): E.1,E.2,E.3 MANUAL.
  ACT (2): M.1,M.2 MANUAL.
Validación app: inherit_rule≠NONE ⇒ scoring_mode=INHERITED y source_control_node_id NOT NULL
  (excepto ANEXO_A_OVERALL que no requiere source_control_node_id).
'''
}

Table "catalog"."question_bank" {
  "id" uuid [pk, not null]
  "name" "character varying(160)" [unique, not null]
  "description" "character varying(500)"
  "scale_id" uuid
  "status" "character varying(20)" [not null, default: `'DRAFT'::charactervarying`]
  "is_base" boolean [not null, default: false, note: 'true = elemento base del instrumento MSPI (no eliminable).']
  "deleted_at" timestamp [note: 'Borrado lógico tras aprobación y gracia. NULL = activa.']
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Indexes {
    deleted_at [type: btree, name: "catalog_question_bank_deleted_at_idx"]
    deleted_at [type: btree, name: "question_bank_deleted_at_idx"]
  }
}

Table "catalog"."question_bank_question" {
  "id" uuid [pk, not null]
  "question_bank_id" uuid [not null]
  "code" "character varying(60)" [not null]
  "domain" "character varying(40)"
  "control" "character varying(120)"
  "question_text" text [not null]
  "category" "character varying(120)"
  "evaluation_type" "character varying(30)"
  "expected_evidence" "character varying(1000)"
  "compliance_criteria" "character varying(1000)"
  "mspi_level" "character varying(60)"
  "nist_function" "character varying(60)"
  "is_active" boolean [not null, default: true]
  "scale_id" uuid
  "position" integer [not null, default: 0]
  "is_selected" boolean [not null, default: true]
