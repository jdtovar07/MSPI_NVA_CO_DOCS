// ============================
// MER - MSPI Platform (PostgreSQL, esquemas por microservicio)
// Generado a partir del DDL real y ejecutado del proyecto:
//   MSPI_NVA_CO_MR_BACK/docker-config/docker/postgres/init/MER-MSPI.sql
// Refleja el estado actual de la base de datos (código), no un diseño aspiracional.
// ============================

Project MSPI_Platform {
  database_type: "PostgreSQL"
  Note: "Una sola instancia de PostgreSQL. Un esquema por microservicio: iam, org, catalog, assessment, evidence, reporting. FK entre esquemas declaradas a nivel de base de datos para integridad referencial."
}

// ============================
// SCHEMA: iam (Identidad, autenticación, auditoría, notificaciones, configuración)
// ============================

Table iam.user {
  id uuid [pk]
  keycloak_sub varchar(80) [unique, not null, note: "Subject del token OIDC emitido por Keycloak"]
  full_name varchar(200) [not null]
  email varchar(254) [unique, not null]
  organization_id uuid [ref: > org.organization.id, note: "Usuario tipo Lector asociado a una organización"]
  must_change_password boolean [not null, default: false]
  password_hash varchar(255) [note: "No se usa con Keycloak como IdP; queda como columna heredada"]
  failed_attempts int [not null, default: 0]
  locked_until timestamptz [note: "Si no es null y > now(), la cuenta está bloqueada"]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    organization_id
    email
  }
}

Table iam.role {
  id uuid [pk]
  name varchar(60) [unique, not null, note: "AdminSistema|AdminInstrumento|Evaluador|Revisor|EvaluadorRevisor|Lector"]
  description varchar(300)
}

Table iam.user_role {
  user_id uuid [not null, ref: > iam.user.id]
  role_id uuid [not null, ref: > iam.role.id]
  assigned_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, role_id) [unique]
    role_id
  }
}

Table iam.user_totp {
  keycloak_sub varchar(80) [pk, ref: > iam.user.keycloak_sub]
  secret varchar(255) [not null]
  enabled_at timestamptz
}

Table iam.system_config {
  key varchar(120) [pk]
  value_json jsonb [not null]
  version int [not null, default: 1]
  updated_by uuid [ref: > iam.user.id]
  updated_at timestamptz [not null, default: `now()`]
}

Table iam.system_config_history {
  id bigserial [pk]
  key varchar(120) [not null]
  version int [not null]
  value_json jsonb [not null]
  changed_by uuid [ref: > iam.user.id]
  changed_at timestamptz [not null, default: `now()`]
  summary varchar(500)
}

Table iam.login_attempt {
  identifier varchar(254) [pk, note: "email o usernameOrEmail usado en el intento de login"]
  failed_count int [not null, default: 0]
  locked_until timestamptz
  updated_at timestamptz [not null, default: `now()`]
}

Table iam.notification {
  id uuid [pk]
  user_id uuid [not null, note: "no tiene FK física (desacoplo intencional); se resuelve por UUID o email en la API"]
  type varchar(40) [not null]
  priority varchar(10) [not null, default: 'MEDIUM', note: "HIGH|MEDIUM|LOW"]
  title varchar(200) [not null]
  message varchar(1000) [not null]
  assessment_id uuid
  assessment_name varchar(200)
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  action_url varchar(400)
}

Table iam.audit_log {
  id bigserial [pk]
  event_type varchar(80) [not null, note: "AUTH_LOGIN_SUCCESS|AUTH_LOGIN_FAILED|AUTH_LOGIN_INACTIVE|ASSESSMENT_STATUS_CHANGE|ASSESSMENT_PUBLISHED|ASSESSMENT_REOPENED|ENTITY_ORDER_TYPE_CHANGED"]
  entity_type varchar(80) [not null, note: "AUTH|ASSESSMENT"]
  entity_id varchar(120) [not null]
  assessment_id uuid [ref: > assessment.assessment.id]
  actor_user_id uuid [ref: > iam.user.id]
  occurred_at timestamptz [not null, default: `now()`]
  ip varchar(64)
  user_agent varchar(400)
  before_json jsonb
  after_json jsonb
  metadata_json jsonb

  indexes {
    (assessment_id, occurred_at)
    (actor_user_id, occurred_at)
    (event_type, occurred_at)
    (entity_type, entity_id)
  }
}

// ============================
// SCHEMA: org (Organizaciones)
// ============================

Table org.organization {
  id uuid [pk]
  name varchar(220) [not null]
  identifier varchar(40) [note: "NIT o identificador interno"]
  type varchar(40)
  status varchar(20) [not null, default: 'ACTIVE']
  address varchar(250)
  city varchar(120)
  department varchar(120)
  country varchar(120)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    name
    identifier
    (name, identifier) [unique]
  }
}

Table org.organization_contact {
  id uuid [pk]
  organization_id uuid [not null, ref: > org.organization.id]
  full_name varchar(200) [not null]
  role varchar(120)
  email varchar(254)
  phone varchar(40)
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    organization_id
    (organization_id, is_primary)
  }
}

// Plantilla de áreas reutilizable por organización — se copia a assessment.assessment_area al crear una evaluación
Table org.organization_area_base {
  id uuid [pk]
  organization_id uuid [not null, ref: > org.organization.id]
  area_name varchar(160) [not null]
  description varchar(300)
  is_critical boolean [not null, default: false]
  position int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table org.organization_area_base_topic {
  id uuid [pk]
  area_base_id uuid [not null, ref: > org.organization_area_base.id]
  topic varchar(220) [not null]
  process_description varchar(400)
  default_steward_role_code varchar(60) [ref: > catalog.steward_role.code]
  staff_name varchar(200)
  staff_role varchar(160)
  staff_contact varchar(200)
  notes varchar(600)
  position int [not null, default: 0]
}

// ============================
// SCHEMA: catalog (Instrumento: escalas, plantillas, controles, PHVA, madurez, NIST, bancos de preguntas)
// ============================

Table catalog.entity_order_type {
  code varchar(20) [pk]
  label varchar(80) [not null]
  phva_expected_advance numeric(5,4) [not null]
  position int [not null]
  active boolean [not null, default: true]
}

Table catalog.scale {
  id uuid [pk]
  name varchar(140) [unique, not null]
  description varchar(400)
  created_at timestamptz [not null, default: `now()`]
}

Table catalog.scale_version {
  id uuid [pk]
  scale_id uuid [not null, ref: > catalog.scale.id]
  version int [not null]
  status varchar(20) [not null, default: 'DRAFT', note: "DRAFT|PUBLISHED"]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table catalog.scale_level {
  id uuid [pk]
  scale_version_id uuid [not null, ref: > catalog.scale_version.id]
  label varchar(80) [not null]
  value int [note: "0..100; null si is_na=true"]
  is_na boolean [not null, default: false]
  criteria_text varchar(1200)
  position int [not null]
}

Table catalog.scale_band {
  id uuid [pk]
  scale_version_id uuid [not null, ref: > catalog.scale_version.id]
  min_value int [not null]
  max_value int [not null]
  label varchar(60) [not null]
  position int [not null]
}

Table catalog.template {
  id uuid [pk]
  name varchar(180) [unique, not null]
  description varchar(500)
  created_at timestamptz [not null, default: `now()`]
}

Table catalog.template_version {
  id uuid [pk]
  template_id uuid [not null, ref: > catalog.template.id]
  scale_version_id uuid [not null, ref: > catalog.scale_version.id]
  version int [not null]
  status varchar(20) [not null, default: 'DRAFT']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  maturity_global_rule varchar(40) [note: "MIN|AVG|MAJORITY"]
  maturity_crit_thresholds jsonb [note: "umbrales SUFICIENTE/INTERMEDIO/CRITICO"]
  phva_weights jsonb [note: "peso por componente PLAN/DO/CHECK/ACT"]
  phva_caps jsonb
  nist_function_targets jsonb [note: "meta por función NIST CSF 2.0 (GV|ID|PR|DE|RS|RC); v1 omitía GV"]
}

Table catalog.iso_domain {
  code varchar(20) [pk, note: "A.5..A.18"]
  name varchar(220) [not null]
  description varchar(600)
  control_type varchar(10) [not null, note: "ADMIN|TECH"]
  display_position int [not null]
  active boolean [not null, default: true]
}

Table catalog.steward_role {
  code varchar(60) [pk]
  label varchar(160) [not null]
  sort_order int [not null, default: 0]
  active boolean [not null, default: true]
}

Table catalog.assessment_area_preset {
  code varchar(40) [pk]
  label varchar(160) [not null]
  position int [not null]
  active boolean [not null, default: true]
}

// Árbol de nodos del instrumento (SECTION | CONTROL), por versión de plantilla
Table catalog.control_catalog_node {
  id uuid [pk]
  template_version_id uuid [not null, ref: > catalog.template_version.id]
  parent_id uuid [ref: > catalog.control_catalog_node.id]
  position int [not null]
  node_type varchar(20) [not null, note: "SECTION|CONTROL"]
  control_type varchar(10) [note: "ADMIN|TECH — solo nodos CONTROL"]
  code varchar(40)
  iso_code varchar(40)
  title varchar(300) [not null]
  description text
  test_guidance text
  iso_domain_code varchar(20) [ref: > catalog.iso_domain.code]
  mspi_tag varchar(120)
  ciber_tag varchar(120)
  is_scored boolean [not null, default: false]
  default_steward_role_code varchar(60) [ref: > catalog.steward_role.code]
  created_at timestamptz [not null, default: `now()`]
}

Table catalog.control_rule {
  id uuid [pk]
  control_node_id uuid [unique, not null, ref: > catalog.control_catalog_node.id]
  requires_evidence boolean [not null, default: false]
  requires_gap boolean [not null, default: false]
  requires_recommendation boolean [not null, default: false]
  recommendation_rule_type varchar(20) [not null, default: 'THRESHOLD', note: "ALWAYS|THRESHOLD|NEVER"]
  recommendation_threshold_value int
  requires_test_checklist boolean [not null, default: false]
  max_files int
  max_text_len jsonb
}

Table catalog.phva_item_catalog {
  id uuid [pk]
  template_version_id uuid [not null, ref: > catalog.template_version.id]
  code varchar(40) [not null]
  component varchar(10) [not null, note: "PLAN|DO|CHECK|ACT"]
  title varchar(280) [not null]
  description text
  test_guidance text
  scoring_mode varchar(12) [not null, default: 'MANUAL', note: "MANUAL|INHERITED"]
  inherit_rule varchar(24) [not null, default: 'NONE']
  source_control_code varchar(40)
  source_control_node_id uuid [ref: > catalog.control_catalog_node.id]
  position int [not null]
  active boolean [not null, default: true]
}

Table catalog.maturity_requirement_catalog {
  id uuid [pk]
  template_version_id uuid [not null, ref: > catalog.template_version.id]
  code varchar(40) [not null, note: "R1..R50 aprox."]
  title varchar(280) [not null]
  description text
  source_type varchar(12) [not null, note: "ADMIN|TECH|PHVA|MATURITY"]
  source_element_code varchar(40) [not null]
  scoring_mode varchar(12) [not null, default: 'INHERITED', note: "MANUAL solo para R5/R9/R10"]
  inherit_rule varchar(24) [not null, default: 'NONE']
  source_control_node_id uuid [ref: > catalog.control_catalog_node.id]
  source_phva_item_code varchar(40)
  composite_phva_codes jsonb
  position int [not null]
  active boolean [not null, default: true]
}

Table catalog.maturity_requirement_control_map {
  id uuid [pk]
  requirement_id uuid [not null, ref: > catalog.maturity_requirement_catalog.id]
  control_node_id uuid [not null, ref: > catalog.control_catalog_node.id]
}

Table catalog.maturity_threshold {
  id uuid [pk]
  requirement_id uuid [not null, ref: > catalog.maturity_requirement_catalog.id]
  level int [not null, note: "1..5"]
  is_na boolean [not null, default: false]
  expected_value int [note: "p.ej. 40/60/80/100"]
}

Table catalog.nist_function {
  id uuid [pk]
  code varchar(20) [unique, not null, note: "GV|ID|PR|DE|RS|RC (CSF 2.0)"]
  name varchar(120) [not null]
  position int [not null, default: 0]
}

Table catalog.nist_subcategory {
  id uuid [pk]
  function_id uuid [not null, ref: > catalog.nist_function.id]
  code varchar(40) [unique, not null, note: "p.ej. DE.AE-1"]
  description text
  active boolean [not null, default: true]
}

Table catalog.nist_mapping {
  id uuid [pk]
  template_version_id uuid [not null, ref: > catalog.template_version.id]
  subcategory_id uuid [not null, ref: > catalog.nist_subcategory.id]
  control_node_id uuid [ref: > catalog.control_catalog_node.id]
  iso_control_code varchar(20) [note: "mapeo alterno cuando no hay control_node_id directo"]
}

Table catalog.nist_ciber_item_catalog {
  id uuid [pk]
  template_version_id uuid [not null, ref: > catalog.template_version.id]
  function_id uuid [not null, ref: > catalog.nist_function.id]
  subcategory_id uuid [not null, ref: > catalog.nist_subcategory.id]
  title varchar(300)
  scoring_mode varchar(12) [not null, default: 'INHERITED']
  source_type varchar(12) [not null, note: "NIST|ISO"]
  inherit_rule varchar(24) [not null, default: 'NONE']
  source_control_node_id uuid [ref: > catalog.control_catalog_node.id]
  iso_control_code varchar(20)
  position int [not null]
  active boolean [not null, default: true]
}

Table catalog.lifting_question_catalog {
  id uuid [pk]
  template_version_id uuid [not null, ref: > catalog.template_version.id]
  code varchar(40) [not null]
  section varchar(120)
  question_text text [not null]
  field_type varchar(30) [not null, note: "TEXT|TEXTAREA|NUMBER|SELECT|MULTISELECT|DATE"]
  is_required boolean [not null, default: false]
  position int [not null]
  options_json jsonb
}

Table catalog.lifting_document_item_catalog {
  id uuid [pk]
  template_version_id uuid [not null, ref: > catalog.template_version.id]
  item_number int [not null]
  block varchar(30) [not null]
  title varchar(300) [not null]
  required_text text [not null]
  hints text
  is_required boolean [not null, default: true]
  is_process_metric boolean [not null, default: false]
  position int [not null]
}

Table catalog.question_bank {
  id uuid [pk]
  name varchar(160) [unique, not null]
  description varchar(500)
  scale_id uuid [ref: > catalog.scale.id]
  status varchar(20) [not null, default: 'DRAFT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table catalog.question_bank_question {
  id uuid [pk]
  question_bank_id uuid [not null, ref: > catalog.question_bank.id]
  code varchar(60) [not null]
  domain varchar(40)
  control varchar(120)
  question_text text [not null]
  category varchar(120)
  evaluation_type varchar(30)
  expected_evidence varchar(1000)
  compliance_criteria varchar(1000)
  mspi_level varchar(60)
  nist_function varchar(60)
  is_active boolean [not null, default: true]
  scale_id uuid [ref: > catalog.scale.id]
  position int [not null, default: 0]
  is_selected boolean [not null, default: true]
  is_required boolean [not null, default: false]
}

// ============================
// SCHEMA: assessment (Ejecución: evaluaciones, controles, PHVA, madurez, NIST, áreas, brechas)
// ============================

Table assessment.assessment {
  id uuid [pk]
  organization_id uuid [not null, ref: > org.organization.id]
  template_version_id uuid [not null, ref: > catalog.template_version.id]
  name varchar(220) [not null]
  organization_name_snapshot varchar(220) [not null]
  evaluation_date date [not null]
  period_label varchar(120)
  contact varchar(254)
  evaluator_display_name varchar(200) [not null]
  prepared_by varchar(200)
  auditor_id uuid [note: "Identificador libre del auditor; no hay catálogo/entidad de auditores en el dominio"]
  auditor_display_name varchar(200)
  created_by uuid [not null, ref: > iam.user.id]
  entity_order_type_code varchar(20) [ref: > catalog.entity_order_type.code]
  phva_expected_advance_snapshot numeric(5,4)
  status varchar(30) [not null, default: 'BORRADOR', note: "BORRADOR|EN_DILIGENCIAMIENTO|EN_REVISION|PUBLICADO|REABIERTO"]
  status_changed_at timestamptz
  status_changed_by uuid [ref: > iam.user.id]
  published_at timestamptz
  published_by uuid [ref: > iam.user.id]
  cloned_from_assessment_id uuid [ref: > assessment.assessment.id]
  row_version int [not null, default: 0, note: "optimistic lock"]
  last_saved_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
}

Table assessment.assessment_edit_lock {
  assessment_id uuid [pk, ref: > assessment.assessment.id]
  locked_by_user_id uuid [not null, ref: > iam.user.id]
  lock_token uuid [not null]
  acquired_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
}

Table assessment.assessment_member {
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  user_id uuid [not null, ref: > iam.user.id]
  member_role varchar(20) [not null, note: "EVALUADOR|REVISOR|EVALUADOR_REVISOR — consultado por AssessmentAccessGuard"]
  is_leader boolean [not null, default: false]
  assigned_at timestamptz [not null, default: `now()`]
}

Table assessment.assessment_metadata {
  assessment_id uuid [pk, ref: > assessment.assessment.id]
  period varchar(120)
  scope text
  prepared_by varchar(200)
  approved_by varchar(200)
  start_date date
  end_date date
  notes text
}

Table assessment.assessment_status_history {
  id bigserial [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  old_status varchar(30) [not null]
  new_status varchar(30) [not null]
  note text
  changed_by uuid [not null, ref: > iam.user.id]
  changed_at timestamptz [not null, default: `now()`]
}

// Snapshot del árbol de control_catalog_node al momento de crear la evaluación (congelado)
Table assessment.assessment_control_node {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  source_catalog_node_id uuid [not null, ref: > catalog.control_catalog_node.id]
  parent_id uuid [ref: > assessment.assessment_control_node.id]
  position int [not null]
  node_type varchar(20) [not null]
  control_type varchar(10)
  code varchar(40)
  iso_code varchar(40)
  title varchar(300) [not null]
  description text
  test_guidance text
  iso_domain_code varchar(20) [ref: > catalog.iso_domain.code]
  mspi_tag varchar(120)
  ciber_tag varchar(120)
  is_scored boolean [not null, default: false]
  rules_json jsonb [note: "snapshot de catalog.control_rule"]
  default_steward_role_code varchar(60) [ref: > catalog.steward_role.code]
}

Table assessment.control_response {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  control_node_id uuid [not null, ref: > assessment.assessment_control_node.id]
  score_status varchar(10) [not null, default: 'SCORED', note: "SCORED|NA"]
  score_value int [note: "0,20,40,60,80,100"]
  evidence_text text
  gap_text text
  recommendation_text text
  control_status varchar(30) [not null, default: 'PENDIENTE']
  steward_source varchar(14) [not null, default: 'FROM_AREA', note: "FROM_AREA|CUSTOM"]
  steward_custom_name varchar(200)
  steward_custom_staff_role varchar(160)
  steward_custom_contact varchar(200)
  updated_by uuid [ref: > iam.user.id]
  updated_at timestamptz [not null, default: `now()`]
  version int [not null, default: 0, note: "optimistic lock"]
}

Table assessment.assessment_phva_item {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  source_catalog_item_id uuid [not null, ref: > catalog.phva_item_catalog.id]
  code varchar(40) [not null]
  component varchar(10) [not null]
  title varchar(280) [not null]
  description text
  test_guidance text
  scoring_mode varchar(12) [not null]
  inherit_rule varchar(24) [not null, default: 'NONE']
  source_control_code varchar(40)
  source_catalog_control_node_id uuid
  source_assessment_control_node_id uuid [ref: > assessment.assessment_control_node.id]
  position int [not null]
}

Table assessment.phva_item_response {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  phva_item_id uuid [not null, ref: > assessment.assessment_phva_item.id]
  score_status varchar(10) [not null, default: 'SCORED']
  score_value int
  evidence_text text
  gap_text text
  updated_by uuid [ref: > iam.user.id]
  updated_at timestamptz [not null, default: `now()`]
  version int [not null, default: 0]
}

Table assessment.assessment_maturity_requirement {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  source_catalog_requirement_id uuid [not null, ref: > catalog.maturity_requirement_catalog.id]
  code varchar(40) [not null]
  title varchar(280) [not null]
  description text
  source_type varchar(12) [not null]
  source_element_code varchar(40) [not null]
  scoring_mode varchar(12) [not null]
  inherit_rule varchar(24) [not null, default: 'NONE']
  source_control_code varchar(40)
  source_catalog_control_node_id uuid
  source_assessment_control_node_id uuid [ref: > assessment.assessment_control_node.id]
  source_phva_item_code varchar(40)
  composite_phva_codes jsonb
  source_catalog_phva_item_id uuid [ref: > catalog.phva_item_catalog.id]
  source_assessment_phva_item_id uuid [ref: > assessment.assessment_phva_item.id]
  position int [not null]
}

Table assessment.assessment_maturity_threshold {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  maturity_requirement_id uuid [not null, ref: > assessment.assessment_maturity_requirement.id]
  level int [not null]
  is_na boolean [not null, default: false]
  expected_value int
}

Table assessment.assessment_maturity_requirement_response {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  maturity_requirement_id uuid [not null, ref: > assessment.assessment_maturity_requirement.id]
  score_status varchar(10) [not null, default: 'SCORED']
  score_value int [note: "solo manual para R5/R9/R10"]
  updated_by uuid [ref: > iam.user.id]
  updated_at timestamptz [not null, default: `now()`]
  version int [not null, default: 0]
}

Table assessment.assessment_nist_ciber_item {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  source_catalog_item_id uuid [not null, ref: > catalog.nist_ciber_item_catalog.id]
  function_id uuid [not null, ref: > catalog.nist_function.id]
  function_code varchar(20) [not null]
  subcategory_id uuid [not null, ref: > catalog.nist_subcategory.id]
  subcategory_code varchar(40) [not null]
  title varchar(300)
  scoring_mode varchar(12) [not null]
  source_type varchar(12) [not null]
  inherit_rule varchar(24) [not null, default: 'NONE']
  iso_control_code varchar(20)
  source_catalog_control_node_id uuid
  source_assessment_control_node_id uuid [ref: > assessment.assessment_control_node.id]
  position int [not null]
}

Table assessment.nist_ciber_item_response {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  nist_ciber_item_id uuid [not null, ref: > assessment.assessment_nist_ciber_item.id]
  score_status varchar(10) [not null, default: 'SCORED']
  score_value int
  evidence_text text
  gap_text text
  updated_by uuid [ref: > iam.user.id]
  updated_at timestamptz [not null, default: `now()`]
  version int [not null, default: 0]
}

Table assessment.control_review {
  id uuid [pk]
  control_response_id uuid [unique, not null, ref: > assessment.control_response.id]
  review_status varchar(20) [not null, note: "VALIDATED|NEEDS_CHANGES"]
  comment text
  severity varchar(20)
  reviewed_by uuid [not null, ref: > iam.user.id]
  reviewed_at timestamptz [not null, default: `now()`]
}

Table assessment.control_comment_thread {
  id uuid [pk]
  control_response_id uuid [not null, ref: > assessment.control_response.id]
  created_by uuid [not null, ref: > iam.user.id]
  created_at timestamptz [not null, default: `now()`]
  is_resolved boolean [not null, default: false]
  resolved_by uuid [ref: > iam.user.id]
  resolved_at timestamptz
}

Table assessment.control_comment {
  id uuid [pk]
  thread_id uuid [not null, ref: > assessment.control_comment_thread.id]
  author_user_id uuid [not null, ref: > iam.user.id]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table assessment.assessment_area {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  area_preset_code varchar(40) [ref: > catalog.assessment_area_preset.code]
  area_name varchar(160) [not null]
  description varchar(400)
  position int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table assessment.assessment_area_topic {
  id uuid [pk]
  area_id uuid [not null, ref: > assessment.assessment_area.id]
  topic varchar(220) [not null]
  process_description varchar(400)
  default_steward_role_code varchar(60) [ref: > catalog.steward_role.code]
  staff_name varchar(200)
  staff_role varchar(160)
  staff_contact varchar(200)
  notes varchar(700)
  position int [not null, default: 0]
}

Table assessment.gap_register {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  control_response_id uuid [ref: > assessment.control_response.id]
  title varchar(220)
  gap_text text [not null]
  priority varchar(10) [not null, default: 'MEDIA', note: "ALTA|MEDIA|BAJA"]
  owner varchar(200)
  due_date date
  status varchar(20) [not null, default: 'PENDIENTE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table assessment.gap_action {
  id uuid [pk]
  gap_id uuid [not null, ref: > assessment.gap_register.id]
  description text [not null]
  owner varchar(200)
  due_date date
  status varchar(20) [not null, default: 'PENDIENTE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ============================
// SCHEMA: evidence (Contexto organizacional, archivos, levantamiento)
// ============================

Table evidence.assessment_context {
  assessment_id uuid [pk, ref: > assessment.assessment.id]
  mission text
  context_analysis text
  process_map text
  organigram text
  self_perception_concern text
  self_perception_maturity text
  self_perception_phva_component text
  updated_by uuid [ref: > iam.user.id]
  updated_at timestamptz [not null, default: `now()`]
  version int [not null, default: 0]
}

Table evidence.evidence_file {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  relation_type varchar(20) [not null, note: "CONTROL|LIFTING_DOC|CONTEXT|GAP_ACTION|REPORT_OUTPUT"]
  relation_id uuid [not null]
  context_field varchar(30)
  filename varchar(260) [not null]
  content_type varchar(120) [not null]
  size_bytes bigint [not null]
  sha256 varchar(80) [not null]
  bucket varchar(120) [not null]
  object_key varchar(500) [not null]
  uploaded_by uuid [not null, ref: > iam.user.id]
  uploaded_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table evidence.lifting_answer {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  question_catalog_id uuid [not null, ref: > catalog.lifting_question_catalog.id]
  answer_json jsonb [not null]
  updated_by uuid [ref: > iam.user.id]
  updated_at timestamptz [not null, default: `now()`]
  version int [not null, default: 0]
}

Table evidence.lifting_document_delivery {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  document_item_catalog_id uuid [not null, ref: > catalog.lifting_document_item_catalog.id]
  delivery_status varchar(20) [not null, default: 'NOT_DELIVERED']
  delivered_name varchar(260)
  notes text
  validated_by uuid [ref: > iam.user.id]
  validated_at timestamptz
  updated_by uuid [ref: > iam.user.id]
  updated_at timestamptz [not null, default: `now()`]
  version int [not null, default: 0]
}

Table evidence.process_scope_metric {
  assessment_id uuid [pk, ref: > assessment.assessment.id]
  total_processes int [not null, default: 0]
  in_scope_processes int [not null, default: 0]
  coverage numeric(6,4)
  in_scope_exceeds_total boolean [not null, default: false]
  updated_by uuid [ref: > iam.user.id]
  updated_at timestamptz [not null, default: `now()`]
}

// ============================
// SCHEMA: reporting (Plantillas, jobs de generación, caché analítico)
// ============================

Table reporting.report_template {
  id uuid [pk]
  code varchar(60) [not null]
  name varchar(120) [not null]
  output_format varchar(10) [not null, note: "PDF|XLSX"]
  version int [not null, default: 1]
  storage_path varchar(500) [not null]
  sections_json jsonb
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table reporting.excel_workbook_template {
  id uuid [pk]
  code varchar(60) [unique, not null]
  name varchar(120) [not null]
  version int [not null, default: 1]
  storage_path varchar(500) [not null]
  sheet_count int [not null, default: 9]
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table reporting.excel_sheet_mapping {
  id uuid [pk]
  workbook_template_id uuid [not null, ref: > reporting.excel_workbook_template.id]
  sheet_key varchar(40) [not null]
  excel_sheet_name varchar(80) [not null]
  sheet_order int [not null]
  excel_layer varchar(12) [not null]
  populate_mode varchar(20) [not null, default: 'VALUES_ONLY']
  data_source varchar(40) [not null]
  cell_map_json jsonb
}

Table reporting.report_generation_job {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  organization_id uuid [not null, ref: > org.organization.id]
  template_id uuid [ref: > reporting.report_template.id]
  workbook_template_id uuid [ref: > reporting.excel_workbook_template.id]
  report_type varchar(40) [not null]
  status varchar(20) [not null, default: 'PENDING', note: "PENDING|RUNNING|DONE|FAILED"]
  page_format varchar(10) [note: "A4|LETTER"]
  request_params jsonb
  requested_by uuid [not null, ref: > iam.user.id]
  requested_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  finished_at timestamptz
  progress_pct int
  output_file_id uuid [ref: > evidence.evidence_file.id]
  error_message text
}

Table reporting.report_job_assessment {
  id uuid [pk]
  job_id uuid [not null, ref: > reporting.report_generation_job.id]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  role varchar(20) [not null, note: "uso en reportes comparativos multi-evaluación"]
  sort_order int [not null, default: 0]
}

Table reporting.analytics_cache {
  id uuid [pk]
  assessment_id uuid [not null, ref: > assessment.assessment.id]
  kind varchar(30) [not null, note: "DOMAIN_EFFECTIVENESS|PHVA|MATURITY|NIST|GAPS|COMPARATIVE|SCALE_PUBLISHED|DIAGNOSTIC"]
  payload_json jsonb [not null]
  source_hash varchar(80) [not null, note: "hash de entradas, para invalidar caché"]
  computed_at timestamptz [not null, default: `now()`]
}
